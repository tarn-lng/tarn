{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tarn",
  "scopeName": "source.tarn",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#interpolated-strings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.tarn",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.double-slash.tarn",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tarn",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.tarn",
          "match": "\\\\(?:[ntr0\\\\\"]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.tarn",
          "match": "\\\\."
        }
      ]
    },
    "interpolated-strings": {
      "name": "string.quoted.double.interpolated.tarn",
      "begin": "\\bf\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.tarn",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.tarn",
          "match": "(\\{)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(\\})",
          "captures": {
            "1": {
              "name": "punctuation.section.interpolation.begin.tarn"
            },
            "2": {
              "name": "variable.other.tarn"
            },
            "3": {
              "name": "punctuation.section.interpolation.end.tarn"
            }
          }
        },
        {
          "name": "invalid.illegal.interpolation.tarn",
          "match": "\\{[^}\"]*\\}?|\\}"
        },
        {
          "name": "constant.character.escape.tarn",
          "match": "\\\\(?:[ntr0\\\\\"]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.tarn",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.tarn",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.tarn",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)(?:<[^\\n{}()]*>)?(\\.))?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.tarn"
            },
            "2": {
              "name": "entity.name.type.tarn"
            },
            "4": {
              "name": "entity.name.function.tarn"
            }
          }
        },
        {
          "match": "\\b(struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.tarn"
            },
            "2": {
              "name": "entity.name.type.tarn"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tarn",
          "match": "\\b(return|if|else|for|in|break|continue|match|try|await|spawn)\\b"
        },
        {
          "name": "keyword.other.contextual.tarn",
          "match": "\\b(?:any(?=\\s+[A-Za-z_])|scope(?=\\s*\\{)|once(?=\\s+fn)|borrows(?=\\s*\\())\\b"
        },
        {
          "name": "keyword.other.tarn",
          "match": "\\b(async|fn|const|struct|enum|interface|impl|copy|var|mut|pub|import|unsafe|extern)\\b"
        },
        {
          "name": "constant.language.boolean.tarn",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.tarn",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.tarn",
          "match": "\\b(bool|i8|i16|i32|i64|u8|u16|u32|u64|isize|usize|f32|f64|string|void|never)\\b"
        },
        {
          "name": "support.type.prelude.tarn",
          "match": "\\b(Option|Result)\\b"
        },
        {
          "name": "support.constant.prelude.tarn",
          "match": "\\b(Some|None|Ok|Err)\\b"
        },
        {
          "name": "entity.name.type.tarn",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.tarn"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.declaration.tarn",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.tarn",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.tarn",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.tarn",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.tarn",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.tarn",
          "match": "[-+*/%&|^<>=]"
        }
      ]
    }
  }
}
