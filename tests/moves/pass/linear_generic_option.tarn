#[must_consume]
struct Frame {
    addr u64
}
fn make() Frame { return Frame{addr: 1} }
fn consume(frame Frame) {
    match frame {
        Frame{addr} => print(addr)
    }
}
fn forward<T>(v Option<T>) Option<T> { return v }
fn main() {
 opt := forward(Some(make()))
 match opt {
  Some(f) => consume(f)
  None => print(0)
 }
}
