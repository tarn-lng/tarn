#[must_consume]
struct Frame {
    addr u64
}
fn make() Frame { return Frame{addr: 1} }
fn consume(frame Frame) {
    match frame {
        Frame{addr} => print(addr)
    }
}
fn main() {
 opt: Option<Option<Frame>> := Some(Some(make()))
 match opt {
  Some(inner) => {
   match inner {
    Some(f) => consume(f)
    None => print(0)
   }
  }
  None => print(0)
 }
}
