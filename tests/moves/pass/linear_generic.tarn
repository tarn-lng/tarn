#[must_consume]
struct Frame {
    addr u64
}
fn make() Frame { return Frame{addr: 1} }
fn consume(frame Frame) {
    match frame {
        Frame{addr} => print(addr)
    }
}
fn forward<T>(value T) T { return value }
struct Box<T> {
 item T
}
fn unpack<T>(value Box<T>) T { return value.item }
fn main() {
 consume(forward(make()))
 consume(unpack(Box{item: make()}))
}
