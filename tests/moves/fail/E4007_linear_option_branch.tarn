#[must_consume]
struct Frame {
    addr u64
}
fn make() Frame { return Frame{addr: 1} }
fn consume(frame Frame) {
    match frame {
        Frame{addr} => print(addr)
    }
}
fn leak(f Option<Frame>) {
 match f {
 Some(value) => print(value.addr)
 None => print(0)
 }
}
fn main() { leak(Some(make())) }
