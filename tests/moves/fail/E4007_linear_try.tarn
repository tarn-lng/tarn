#[must_consume]
struct Frame {
    addr u64
}
fn make() Frame { return Frame{addr: 1} }
fn consume(frame Frame) {
    match frame {
        Frame{addr} => print(addr)
    }
}
fn operation() Result<i32, i32> { return Err(1) }
fn run() Result<i32, i32> {
 f := make()
 n := try operation()
 consume(f)
 return Ok(n)
}
fn main() { run() }
