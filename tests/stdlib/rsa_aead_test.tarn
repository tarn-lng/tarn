// ADR 0100: RSASSA-PKCS1-v1_5 SHA-256 and ChaCha20-Poly1305. Expected values
// come from independent implementations (OpenSSL 4.1 signatures, Python
// cryptography for AEAD) plus the RFC 8439 section 2.8.2 vector. Test-only keys.
import "crypto"
import "encoding"
import "string"
import "testing"

