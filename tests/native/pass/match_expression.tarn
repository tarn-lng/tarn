enum Shape {
    Circle(i64)
    Square(i64)
    Empty
}
fn area(s &Shape) i64 {
    return match s {
        Circle(r) => 3 * r * r
        Square(side) => side * side
        Empty => 0
    }
}
fn name(code i32) string {
    return match code {
        0 => "zero"
        1 => "one"
        _ => "many"
    }
}
fn parse(text &string) Result<i64, string> {
    x := match text.len() {
        0 => { return Err("empty") }
        n => i64(n)
    }
    return Ok(x * 10)
}
fn main() {
    print(area(&Shape.Circle(2)) + area(&Shape.Square(3)) + area(&Shape.Empty))
    var owned: Option<string> = Some("moved")
    s := match owned {
        Some(v) => v
        None => "none"
    }
    print(s)
    print(name(1))
    print(match parse(&"abc") {
        Ok(v) => v
        Err(e) => -1
    })
    var total: i64 = 0
    for i in 0..4 {
        total = total + match i % 2 {
            0 => i
            _ => { continue }
        }
    }
    print(total)
}
