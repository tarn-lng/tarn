import "io"
import "runtime"
import "net"
fn require(value bool) { if !value { panic("suspended assertion") } }
fn main() Result<void, io.Error> {
    execution := try runtime.Execution.new()
    var listener = try net.TcpListener.bind(&"127.0.0.1:0")
    try listener.set_nonblocking(true)
    address := try listener.local_addr()
    var accept = runtime.accept_operation(&execution, &mut listener)
    match accept.poll() { io.Progress.Pending => {}
        io.Progress.Ready(value) => panic("accept did not suspend") }
    var client = try net.TcpStream.connect_addr(address)
    try execution.wait(5000)
    var server: net.TcpStream
    match accept.poll() { io.Progress.Ready(value) => { server = try value }
        io.Progress.Pending => panic("accept still pending") }
    accept.finish()
    try server.set_nonblocking(true)
    var buffer = [2]u8{0, 0}
    var read = runtime.read_operation(&execution, &mut server, &mut buffer)
    match read.poll() { io.Progress.Pending => {}
        io.Progress.Ready(value) => panic("read did not suspend") }
    read.wake()
    read.wake()
    require(read.runnable())
    require(!read.runnable())
    match read.poll() { io.Progress.Pending => {}
        io.Progress.Ready(value) => panic("spurious wake completed") }
    try client.write_all(&[2]u8{41, 42})
    try execution.wait(5000)
    require(read.runnable())
    match read.poll() { io.Progress.Ready(value) => { require(try value == usize(2)) }
        io.Progress.Pending => panic("read still pending") }
    read.finish()
    require(buffer[1] == u8(42))
    buffer[0] = u8(99)
    try client.set_nonblocking(true)
    var write = runtime.write_operation(&execution, &mut client, &buffer)
    match write.poll() { io.Progress.Ready(value) => { require(try value == usize(2)) }
        io.Progress.Pending => panic("immediate write pending") }
    write.finish()
    var drain = runtime.read_operation(&execution, &mut server, &mut buffer)
    // Loopback delivery can be asynchronous, so the bytes may need a readiness wait.
    match drain.poll() { io.Progress.Ready(value) => { require(try value == usize(2)) }
        io.Progress.Pending => {
            try execution.wait(5000)
            require(drain.runnable())
            match drain.poll() { io.Progress.Ready(value) => { require(try value == usize(2)) }
                io.Progress.Pending => panic("drain pending") }
        } }
    drain.finish()
    // Abandon Pending read, release loans and remove its registration.
    {
        var abandoned = runtime.read_operation(&execution, &mut server, &mut buffer)
        match abandoned.poll() { io.Progress.Pending => {}
            io.Progress.Ready(value) => panic("abandon read ready") }
    }
    buffer[0] = u8(0)
    // A peer close wakes a suspended read and yields EOF, not a stale count.
    var eof = runtime.read_operation(&execution, &mut server, &mut buffer)
    match eof.poll() { io.Progress.Pending => {}
        io.Progress.Ready(value) => panic("EOF read did not suspend") }
    try client.close()
    try execution.wait(5000)
    match eof.poll() { io.Progress.Ready(value) => { require(try value == usize(0)) }
        io.Progress.Pending => panic("peer close did not wake read") }
    eof.finish()
    try server.close()
    var receiver = try net.UdpSocket.bind(&"127.0.0.1:0")
    var sender = try net.UdpSocket.bind(&"127.0.0.1:0")
    try receiver.set_nonblocking(true)
    peer := try receiver.local_addr()
    var recv = runtime.recv_operation(&execution, &mut receiver, &mut buffer)
    match recv.poll() { io.Progress.Pending => {}
        io.Progress.Ready(value) => panic("udp ready") }
    try sender.send_to(&[0]u8{}, peer)
    try execution.wait(5000)
    match recv.poll() { io.Progress.Ready(value) => { require((try value).count == usize(0)) }
        io.Progress.Pending => panic("empty datagram pending") }
    recv.finish()
    var connecting = try net.TcpStream.connect_nonblocking_addr(address)
    var connect = runtime.connect_operation(&execution, &mut connecting)
    var complete = false
    for !complete {
        match connect.poll() { io.Progress.Ready(value) => { try value
                complete = true }
            io.Progress.Pending => { try execution.wait(5000) } }
    }
    connect.finish()
    transferred := try connecting.into_stream()
    try transferred.close()
    print("suspended ok")
    return Ok(())
}
