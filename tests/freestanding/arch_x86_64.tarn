// Every x86_64 CPU intrinsic in a freestanding program (ADR 0101, P5).
// Compiled only; running these needs ring 0.
import "arch_x86_64"
import "ffi"

fn serial_write(byte u8) {
    unsafe {
        arch_x86_64.out8(1016, byte)
        status := arch_x86_64.in8(1021)
        wide := arch_x86_64.in16(1016) + 1
        wider := arch_x86_64.in32(1016) + 1
        arch_x86_64.out16(1016, wide)
        arch_x86_64.out32(1016, wider)
    }
}

fn on_stack(value u64) {}

fn main() {
    serial_write(65)
    unsafe {
        arch_x86_64.cli()
        arch_x86_64.sti_hlt()
        arch_x86_64.pause()
        arch_x86_64.int3()
        cr0 := arch_x86_64.read_cr0()
        cr2 := arch_x86_64.read_cr2()
        cr3 := arch_x86_64.read_cr3()
        cr4 := arch_x86_64.read_cr4()
        arch_x86_64.write_cr0(cr0)
        arch_x86_64.write_cr3(cr3)
        arch_x86_64.write_cr4(cr4)
        arch_x86_64.invlpg(cr2)
        msr := arch_x86_64.rdmsr(192)
        arch_x86_64.wrmsr(192, msr)
        table: *mut u8 := ffi.from_address(4096)
        arch_x86_64.lgdt(ffi.to_const(table))
        arch_x86_64.lidt(ffi.to_const(table))
        ticks := arch_x86_64.rdtsc()
        // ADR 0107 (T6)
        arch_x86_64.ltr(40)
        tr := arch_x86_64.str()
        id := arch_x86_64.cpuid(0, 0)
        arch_x86_64.ud2()
        xcr := arch_x86_64.xgetbv(0)
        arch_x86_64.xsetbv(0, xcr)
        arch_x86_64.wbinvd()
        arch_x86_64.clflush(cr2)
        arch_x86_64.invpcid(2, ffi.to_const(table))
        arch_x86_64.swapgs()
        fs := arch_x86_64.rdfsbase()
        gs := arch_x86_64.rdgsbase()
        arch_x86_64.wrfsbase(fs)
        arch_x86_64.wrgsbase(gs + u64(id.eax + id.ebx + id.ecx + id.edx) + u64(tr))
        flags := arch_x86_64.read_rflags()
        arch_x86_64.call_on_stack(flags, ffi.callback(on_stack), 1)
        arch_x86_64.sti()
        arch_x86_64.hlt()
    }
}

#[export("contexts")]
fn contexts() {
    unsafe {
        arch_x86_64.context_init(FROM, 0x20000, ffi.callback(on_stack), 41)
        arch_x86_64.context_init(TO, 0x10000, ffi.callback(on_stack), 42)
        arch_x86_64.context_switch(FROM, ffi.to_const(TO))
        arch_x86_64.stac()
        arch_x86_64.clac()
        arch_x86_64.switch_stack(0x10000, ffi.callback(on_stack), 42)
    }
}

#[section(".context_from")]
static mut FROM arch_x86_64.Context
static mut TO arch_x86_64.Context

#[export("rng_calls")]
fn rng_calls() u64 {
    unsafe {
        if !arch_x86_64.has_rdrand() || !arch_x86_64.has_rdseed() { return 0 }
        a := arch_x86_64.rdrand64()
        b := arch_x86_64.rdseed64()
        if a.success && b.success { return a.value ^ b.value }
        return 0
    }
}
