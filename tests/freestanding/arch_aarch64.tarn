// Every aarch64 CPU intrinsic in a freestanding program (ADR 0101, P5).
// Compiled only; running these needs EL1.
import "arch_aarch64"
import "ffi"

fn on_stack(value u64) {}

fn main() {
    unsafe {
        arch_aarch64.wfi()
        arch_aarch64.wfe()
        arch_aarch64.isb()
        arch_aarch64.dsb_sy()
        arch_aarch64.dmb_sy()
        arch_aarch64.irq_enable()
        arch_aarch64.irq_disable()
        r0 := arch_aarch64.read_daif()
        r1 := arch_aarch64.read_vbar_el1()
        r2 := arch_aarch64.read_ttbr0_el1()
        r3 := arch_aarch64.read_ttbr1_el1()
        r4 := arch_aarch64.read_tcr_el1()
        r5 := arch_aarch64.read_mair_el1()
        r6 := arch_aarch64.read_sctlr_el1()
        cpacr := arch_aarch64.read_cpacr_el1()
        r7 := arch_aarch64.read_currentel()
        r8 := arch_aarch64.read_esr_el1()
        r9 := arch_aarch64.read_far_el1()
        r10 := arch_aarch64.read_elr_el1()
        r11 := arch_aarch64.read_spsr_el1()
        r12 := arch_aarch64.read_cntv_ctl_el0()
        r13 := arch_aarch64.read_cntv_tval_el0()
        r14 := arch_aarch64.read_cntfrq_el0()
        r15 := arch_aarch64.read_cntvct_el0()
        arch_aarch64.write_daif(r0)
        arch_aarch64.write_vbar_el1(r0)
        arch_aarch64.write_ttbr0_el1(r0)
        arch_aarch64.write_ttbr1_el1(r0)
        arch_aarch64.write_tcr_el1(r0)
        arch_aarch64.write_mair_el1(r0)
        arch_aarch64.write_sctlr_el1(r0)
        arch_aarch64.write_cpacr_el1(cpacr)
        arch_aarch64.write_esr_el1(r0)
        arch_aarch64.write_far_el1(r0)
        arch_aarch64.write_elr_el1(r0)
        arch_aarch64.write_spsr_el1(r0)
        arch_aarch64.write_cntv_ctl_el0(r0)
        arch_aarch64.write_cntv_tval_el0(r0)
        arch_aarch64.svc()
        arch_aarch64.brk()
        arch_aarch64.semihost_exit(r0)
        i0 := arch_aarch64.read_icc_sre_el1()
        i1 := arch_aarch64.read_icc_pmr_el1()
        i2 := arch_aarch64.read_icc_igrpen1_el1()
        i3 := arch_aarch64.read_icc_iar1_el1()
        i4 := arch_aarch64.read_icc_eoir1_el1()
        arch_aarch64.write_icc_sre_el1(i0)
        arch_aarch64.write_icc_pmr_el1(i1)
        arch_aarch64.write_icc_igrpen1_el1(i2)
        arch_aarch64.write_icc_eoir1_el1(i3 + i4)
        // ADR 0107 (T6)
        arch_aarch64.tlbi_vmalle1()
        arch_aarch64.tlbi_vmalle1is()
        arch_aarch64.tlbi_vae1(r0, 7)
        arch_aarch64.tlbi_vae1is(r0, 7)
        arch_aarch64.tlbi_vale1(r0, 7)
        arch_aarch64.tlbi_aside1(7)
        arch_aarch64.dsb_ish()
        arch_aarch64.dsb_ishst()
        arch_aarch64.dsb_nsh()
        arch_aarch64.dsb_nshst()
        arch_aarch64.dmb_ish()
        arch_aarch64.dmb_ishld()
        arch_aarch64.dmb_ishst()
        arch_aarch64.ic_iallu()
        arch_aarch64.ic_ialluis()
        arch_aarch64.ic_ivau(r0)
        arch_aarch64.dc_civac(r0)
        arch_aarch64.dc_cvac(r0)
        arch_aarch64.dc_ivac(r0)
        arch_aarch64.dc_zva(r0)
        arch_aarch64.dc_cvau(r0)
        arch_aarch64.at_s1e1r(r0)
        arch_aarch64.at_s1e1w(r0)
        par := arch_aarch64.read_par_el1()
        ids := arch_aarch64.read_id_aa64mmfr0_el1() + arch_aarch64.read_id_aa64mmfr1_el1() + arch_aarch64.read_id_aa64pfr0_el1()
        ids2 := arch_aarch64.read_ctr_el0() + arch_aarch64.read_dczid_el0() + arch_aarch64.read_midr_el1() + arch_aarch64.read_mpidr_el1()
        sp0 := arch_aarch64.read_sp_el0()
        arch_aarch64.write_sp_el0(sp0 + par + ids + ids2)
        arch_aarch64.call_on_stack(sp0, ffi.callback(on_stack), 1)
    }
}

#[export("contexts")]
fn contexts() {
    unsafe {
        arch_aarch64.context_init(FROM, 0x20000, ffi.callback(on_stack), 41)
        arch_aarch64.context_init(TO, 0x10000, ffi.callback(on_stack), 42)
        arch_aarch64.context_switch(FROM, ffi.to_const(TO))
        sp := arch_aarch64.read_sp()
        sel := arch_aarch64.read_spsel()
        arch_aarch64.write_spsel(sel)
        pan := arch_aarch64.read_pan()
        arch_aarch64.pan_enable()
        arch_aarch64.pan_disable()
        if sel == 0 { arch_aarch64.switch_stack_el0(sp + pan, ffi.callback(on_stack), 42) }
        arch_aarch64.switch_stack(0x10000, ffi.callback(on_stack), 42)
    }
}

#[section(".context_from")]
static mut FROM arch_aarch64.Context
static mut TO arch_aarch64.Context

#[export("rng_calls")]
fn rng_calls() u64 {
    unsafe {
        if !arch_aarch64.has_rng() { return 0 }
        a := arch_aarch64.rndr()
        b := arch_aarch64.rndrrs()
        if a.success && b.success { return a.value ^ b.value }
        return 0
    }
}
