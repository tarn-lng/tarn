// An x86_64 kernel written in Tarn (ADR 0101, P8). It boots under QEMU's PVH
// loader, talks to COM1, handles interrupts and runs on a heap it implements
// itself. See README.md for the build and run commands.
import "arch_x86_64"
import "ffi"

const COM1 u16 = 0x3f8
const DEBUG_EXIT u16 = 0xf4
const PIC1 u16 = 0x20
const PIC2 u16 = 0xa0
const PIT_CHANNEL0 u16 = 0x40
const PIT_COMMAND u16 = 0x43
const TICKS_WANTED u64 = 10

// QEMU's isa-debug-exit turns a write of `v` into the process status `v * 2 + 1`.
const EXIT_OK u32 = 16
const EXIT_FAILED u32 = 17

// ---------------------------------------------------------------- memory access

fn peek(address usize) u64 {
    p: *u64 := ffi.from_address(address)
    unsafe { return ffi.read_volatile(p) }
}

fn poke(address usize, value u64) {
    p: *mut u64 := ffi.from_address(address)
    unsafe { ffi.write_volatile(p, value) }
}

// ---------------------------------------------------------------- serial port

fn serial_init() {
    unsafe {
        arch_x86_64.out8(COM1 + 1, 0)  // no UART interrupts
        arch_x86_64.out8(COM1 + 3, 0x80)  // DLAB on
        arch_x86_64.out8(COM1, 1)  // divisor 1: 115200 baud
        arch_x86_64.out8(COM1 + 1, 0)
        arch_x86_64.out8(COM1 + 3, 3)  // 8 data bits, no parity, one stop bit
        arch_x86_64.out8(COM1 + 2, 0xc7)  // FIFO on
        arch_x86_64.out8(COM1 + 4, 0x0b)  // DTR, RTS, OUT2
    }
}

fn serial_byte(byte u8) {
    unsafe {
        for (arch_x86_64.in8(COM1 + 5) & 0x20) == 0 {
            arch_x86_64.pause()
        }
        arch_x86_64.out8(COM1, byte)
    }
}

fn print_text(text &string) {
    bytes := text.bytes()
    var i: usize = 0
    for i < bytes.len() {
        serial_byte(bytes[i])
        i = i + 1
    }
}

fn print_number(value u64) {
    var divisor: u64 = 1
    for value / divisor >= 10 {
        divisor = divisor * 10
    }
    for divisor > 0 {
        serial_byte(u8(48 + (value / divisor) % 10))
        divisor = divisor / 10
    }
}

fn print_hex(value u64) {
    serial_byte(48)
    serial_byte(120)
    var shift: u64 = 60
    var more = true
    for more {
        var digit: u64 = (value >> shift) & 15
        if digit < 10 {
            digit = digit + 48
        } else {
            digit = digit + 87
        }
        serial_byte(u8(digit))
        if shift == 0 {
            more = false
        } else {
            shift = shift - 4
        }
    }
}

fn newline() {
    serial_byte(10)
}

fn println(text &string) {
    print_text(text)
    newline()
}

// Write the text of a Tarn string the compiler hands to the panic handler
// (a pointer to `{ len u64, bytes... }`).
fn print_raw(message *u8) {
    address := ffi.address(message)
    length := peek(address)
    var i: u64 = 0
    for i < length {
        byte: *u8 := ffi.from_address(address + 8 + usize(i))
        unsafe { serial_byte(ffi.read(byte)) }
        i = i + 1
    }
}

fn exit(code u32) {
    unsafe {
        arch_x86_64.out32(DEBUG_EXIT, code)
        for true { arch_x86_64.hlt() }
    }
}

// ---------------------------------------------------------------- panic handler

#[export("tarn_rt_fault")]
fn fault() {
    println("FAULT: integer overflow, bad index or failed allocation")
    exit(EXIT_FAILED)
}

#[export("tarn_rt_panic")]
fn panic_message(message *u8) {
    print_text("PANIC: ")
    print_raw(message)
    newline()
    exit(EXIT_FAILED)
}

#[export("tarn_rt_panic_at")]
fn panic_at(message *u8, location *u8) {
    print_text("PANIC: ")
    print_raw(message)
    print_text(" at ")
    print_raw(location)
    newline()
    exit(EXIT_FAILED)
}

// ---------------------------------------------------------------- heap
//
// A first-fit free list over a static arena. Every block starts with a
// 16-byte header { size u64, next u64 }; `next` links freed blocks. Memory
// that was never allocated is handed out from the top of the arena.

const HEAP_SIZE usize = 1048576
const HEADER usize = 16

#[align(4096)]
static mut HEAP[1048576]u8
static mut HEAP_TOP usize = 0
static mut FREE_LIST usize = 0
static mut LIVE usize = 0

fn heap_base() usize {
    return ffi.address(HEAP)
}

fn round16(n usize) usize {
    return ((n + 15) / 16) * 16
}

#[export("tarn_alloc")]
fn alloc(size usize) *mut u8 {
    need := round16(size)
    top := ffi.address(HEAP_TOP)
    free := ffi.address(FREE_LIST)
    // First fit among freed blocks.
    var previous: usize = 0
    var block: usize = usize(peek(free))
    for block != 0 {
        if usize(peek(block)) >= need {
            next := peek(block + 8)
            if previous == 0 {
                poke(free, next)
            } else {
                poke(previous + 8, next)
            }
            unsafe { ffi.write_volatile(ffi.from_address(ffi.address(LIVE)), usize(peek(ffi.address(LIVE))) + 1) }
            result: *mut u8 := ffi.from_address(block + HEADER)
            return result
        }
        previous = block
        block = usize(peek(block + 8))
    }
    used := usize(peek(top))
    if used + HEADER + need > HEAP_SIZE {
        return ffi.null()
    }
    block = heap_base() + used
    poke(block, u64(need))
    poke(block + 8, 0)
    poke(top, u64(used + HEADER + need))
    poke(ffi.address(LIVE), peek(ffi.address(LIVE)) + 1)
    result: *mut u8 := ffi.from_address(block + HEADER)
    return result
}

#[export("tarn_free")]
fn release(pointer *mut u8) {
    if ffi.is_null(ffi.to_const(pointer)) {
        return
    }
    block := ffi.address(pointer) - HEADER
    free := ffi.address(FREE_LIST)
    poke(block + 8, peek(free))
    poke(free, u64(block))
    poke(ffi.address(LIVE), peek(ffi.address(LIVE)) - 1)
}

#[export("tarn_realloc")]
fn resize(pointer *mut u8, size usize) *mut u8 {
    if ffi.is_null(ffi.to_const(pointer)) {
        return alloc(size)
    }
    block := ffi.address(pointer) - HEADER
    have := usize(peek(block))
    if size <= have {
        return pointer
    }
    fresh := alloc(size)
    if ffi.is_null(ffi.to_const(fresh)) {
        return fresh
    }
    var i: usize = 0
    for i < have {
        unsafe { ffi.write(ffi.offset_mut(fresh, i), ffi.read(ffi.to_const(ffi.offset_mut(pointer, i)))) }
        i = i + 1
    }
    release(pointer)
    return fresh
}

// ---------------------------------------------------------------- interrupts

#[align(4096)]
static mut IDT[4096]u8
static mut TICKS u64 = 0
static mut BREAKPOINTS u64 = 0

#[interrupt]
fn breakpoint(frame *mut arch_x86_64.InterruptFrame) {
    // `int3` is a trap: the saved rip already points after it.
    poke(ffi.address(BREAKPOINTS), peek(ffi.address(BREAKPOINTS)) + 1)
}

#[interrupt]
fn timer(frame *mut arch_x86_64.InterruptFrame) {
    poke(ffi.address(TICKS), peek(ffi.address(TICKS)) + 1)
    unsafe { arch_x86_64.out8(PIC1, 0x20) }  // EOI before suspending this handler
    schedule_tick()
}

fn crash(name &string, frame *mut arch_x86_64.InterruptFrame, code u64) {
    print_text("EXCEPTION ")
    print_text(name)
    print_text(" code=")
    print_hex(code)
    print_text(" rip=")
    unsafe { print_hex(arch_x86_64.frame_rip(ffi.to_const(frame))) }
    newline()
    exit(EXIT_FAILED)
}

// The deliberate double fault of `double_fault_demo` (below) is expected once.
static mut EXPECT_DF u64 = 0

#[interrupt]
fn double_fault(frame *mut arch_x86_64.InterruptFrame, code u64) {
    if peek(ffi.address(EXPECT_DF)) == 1 {
        // IST1 gave this handler its own stack: a local variable is in IST_STACK.
        var marker: u64 = 0
        here := ffi.address(ffi.of(&marker))
        base := ffi.address(IST_STACK)
        if here < base || here >= base + IST_SIZE { panic("double fault did not run on the IST stack") }
        print_text("double fault: bad rsp=")
        unsafe { print_hex(arch_x86_64.frame_rsp(ffi.to_const(frame))) }
        newline()
        println("double fault: handled on the IST stack")
        println("tarn kernel: done")
        exit(EXIT_OK)
    }
    crash("double fault", frame, code)
}

#[interrupt]
fn general_protection(frame *mut arch_x86_64.InterruptFrame, code u64) {
    crash("general protection", frame, code)
}

#[interrupt]
fn page_fault(frame *mut arch_x86_64.InterruptFrame, code u64) {
    print_text("cr2=")
    unsafe { print_hex(arch_x86_64.read_cr2()) }
    newline()
    crash("page fault", frame, code)
}

#[interrupt]
fn invalid_opcode(frame *mut arch_x86_64.InterruptFrame) {
    crash("invalid opcode", frame, 0)
}

// Link-time relocations name interrupt trampolines, not their ordinary bodies.
static HANDLERS [6]*u8 = [6]*u8{ffi.callback(breakpoint), ffi.callback(invalid_opcode), ffi.callback(double_fault), ffi.callback(general_protection), ffi.callback(page_fault), ffi.callback(timer)}

fn handler_address(slot usize) *u8 {
    unsafe { return ffi.read(HANDLERS[slot]) }
}

fn install_idt() {
    idt: *mut u8 := ffi.from_address(ffi.address(IDT))
    unsafe {
        arch_x86_64.idt_set_gate(idt, 3, handler_address(0), 8, 0, arch_x86_64.gate_trap())
        arch_x86_64.idt_set_gate(idt, 6, handler_address(1), 8, 0, arch_x86_64.gate_interrupt())
        arch_x86_64.idt_set_gate(idt, 8, handler_address(2), 8, 1, arch_x86_64.gate_interrupt())
        arch_x86_64.idt_set_gate(idt, 13, handler_address(3), 8, 0, arch_x86_64.gate_interrupt())
        arch_x86_64.idt_set_gate(idt, 14, handler_address(4), 8, 0, arch_x86_64.gate_interrupt())
        arch_x86_64.idt_set_gate(idt, 32, handler_address(5), 8, 0, arch_x86_64.gate_interrupt())
        arch_x86_64.idt_load(ffi.to_const(idt), 256)
    }
}

// Remap the 8259 PICs to vectors 32..47 and unmask only IRQ0 (the PIT).
fn init_pic() {
    unsafe {
        arch_x86_64.out8(PIC1, 0x11)
        arch_x86_64.out8(PIC2, 0x11)
        arch_x86_64.out8(PIC1 + 1, 32)
        arch_x86_64.out8(PIC2 + 1, 40)
        arch_x86_64.out8(PIC1 + 1, 4)
        arch_x86_64.out8(PIC2 + 1, 2)
        arch_x86_64.out8(PIC1 + 1, 1)
        arch_x86_64.out8(PIC2 + 1, 1)
        arch_x86_64.out8(PIC1 + 1, 0xfe)
        arch_x86_64.out8(PIC2 + 1, 0xff)
    }
}

// PIT channel 0, rate generator, 1193182 Hz / 11932 = about 100 Hz.
fn init_pit() {
    unsafe {
        arch_x86_64.out8(PIT_COMMAND, 0x34)
        arch_x86_64.out8(PIT_CHANNEL0, u8(11932 & 0xff))
        arch_x86_64.out8(PIT_CHANNEL0, u8(11932 >> 8))
    }
}

// ---------------------------------------------------------------- GDT, TSS, cpuid, stacks (ADR 0107)

const IST_SIZE usize = 16384
#[align(16)]
static mut IST_STACK [16384]u8
#[align(16)]
static mut SIDE_STACK [16384]u8
#[align(16)]
static mut GDT [48]u8
#[align(16)]
static mut GDTR [16]u8
#[align(16)]
static mut TSS [128]u8
static mut SIDE_RAN u64 = 0
static mut SIDE_ARG u64 = 0

fn print_vendor(value u32) {
    var shift: u32 = 0
    for shift < 32 {
        serial_byte(u8((value >> shift) & 255))
        shift = shift + 8
    }
}

fn cpuid_demo() {
    unsafe {
        id := arch_x86_64.cpuid(0, 0)
        print_text("cpuid vendor: ")
        print_vendor(id.ebx)
        print_vendor(id.edx)
        print_vendor(id.ecx)
        newline()
        print_text("cpuid max leaf: ")
        print_number(u64(id.eax))
        newline()
    }
}

// GDT: null, 64-bit code (8), data (16), available 64-bit TSS (24, 16 bytes).
// The code and data descriptors equal the boot GDT's, so no segment reload is needed.
fn install_tss() {
    gdt := ffi.address(GDT)
    tss := ffi.address(TSS)
    poke(gdt, 0)
    poke(gdt + 8, 0x00af9b000000ffff)
    poke(gdt + 16, 0x00cf93000000ffff)
    poke(gdt + 24, 103 | ((u64(tss) & 0xffff) << 16) | (((u64(tss) >> 16) & 0xff) << 32) | (0x89 << 40) | (((u64(tss) >> 24) & 0xff) << 56))
    poke(gdt + 32, u64(tss) >> 32)
    // TSS: IST1 at offset 0x24; I/O map base (0x66) = 104 = no I/O bitmap.
    poke(tss + 0x24, u64(ffi.address(IST_STACK) + IST_SIZE))
    poke(tss + 0x64, 104 << 16)
    gdtr := ffi.address(GDTR)
    poke(gdtr, 39 | (u64(gdt) << 16))
    poke(gdtr + 8, u64(gdt) >> 48)
    unsafe {
        arch_x86_64.lgdt(ffi.from_address(gdtr))
        arch_x86_64.ltr(24)
        if arch_x86_64.str() != 24 { panic("str does not report the loaded task register") }
    }
    println("tss: loaded with ltr, str reports selector 0x18")
}

fn on_side_stack(arg u64) {
    var marker: u64 = 0
    here := ffi.address(ffi.of(&marker))
    base := ffi.address(SIDE_STACK)
    if here < base || here >= base + IST_SIZE { panic("call_on_stack: callee is not on the new stack") }
    poke(ffi.address(SIDE_ARG), arg)
    poke(ffi.address(SIDE_RAN), 1)
}

fn call_on_stack_demo() {
    var marker: u64 = 0
    here := ffi.address(ffi.of(&marker))
    base := ffi.address(SIDE_STACK)
    if here >= base && here < base + IST_SIZE { panic("test starts on the side stack") }
    unsafe { arch_x86_64.call_on_stack(u64(base + IST_SIZE), ffi.callback(on_side_stack), 77) }
    if peek(ffi.address(SIDE_RAN)) != 1 || peek(ffi.address(SIDE_ARG)) != 77 { panic("call_on_stack did not run the callee") }
    println("call_on_stack: ran on the new stack and returned")
    // A second call proves the old stack and callee-saved state came back intact.
    unsafe { arch_x86_64.call_on_stack(u64(base + IST_SIZE), ffi.callback(on_side_stack), 78) }
    if peek(ffi.address(SIDE_ARG)) != 78 { panic("second call_on_stack failed") }
    println("call_on_stack: twice")
}

fn on_bad_stack(arg u64) {
    panic("unreachable: the bad stack has no memory")
}

// A stack that is canonical but unmapped: the callee's return address push
// faults, the #PF delivery faults on the same stack, and the CPU raises #DF,
// which the IDT gives IST1: the handler runs on `IST_STACK` and ends the kernel.
fn double_fault_demo() {
    poke(ffi.address(EXPECT_DF), 1)
    unsafe { arch_x86_64.call_on_stack(0x700000000000, ffi.callback(on_bad_stack), 0) }
    panic("no double fault was raised")
}

// ---------------------------------------------------------------- tests

fn heap_demo() {
    var numbers: Vec<i64> = Vec.new()
    var n: i64 = 0
    for n < 1000 {
        numbers.push(n * n)
        n = n + 1
    }
    var sum: i64 = 0
    var i: usize = 0
    for i < numbers.len() {
        sum = sum + numbers.at(i)
        i = i + 1
    }
    if sum != 332833500 {
        panic("vec sum is wrong")
    }
    greeting := "hello, " + "heap " + "world"
    println(&greeting)
    print_text("vec of 1000 squares sums to ")
    print_number(u64(sum))
    newline()
}

fn heap_reuse() {
    top := ffi.address(HEAP_TOP)
    heap_demo()
    after_first := peek(top)
    heap_demo()
    after_second := peek(top)
    if after_second != after_first {
        print_text("heap grew from ")
        print_number(after_first)
        print_text(" to ")
        print_number(after_second)
        newline()
        panic("freed blocks are not reused")
    }
    print_text("heap ok: ")
    print_number(after_second)
    println(" bytes in use at the top, freed blocks reused")
}

// Prefix of Xen's hvm_start_info, using the C layout supplied by PVH.
struct PvhStartInfo {
    magic u32
    version u32
    flags u32
    nr_modules u32
    modlist_paddr u64
    cmdline_paddr u64
    rsdp_paddr u64
}

#[pvh_entry]
#[export("kmain")]
fn kmain(info u64) {
    serial_init()
    println("tarn kernel: booted")
    boot: *PvhStartInfo := ffi.from_address(usize(info))
    unsafe {
        if ffi.read(boot.magic) == 0x336ec578 {
            println("pvh start info: magic ok")
        } else {
            panic("no hvm_start_info from the loader")
        }
    }
    heap_reuse()

    install_idt()
    unsafe { arch_x86_64.int3() }
    if peek(ffi.address(BREAKPOINTS)) != 1 {
        panic("breakpoint handler did not run")
    }
    println("int3: breakpoint handled")
    cpuid_demo()
    smap_demo()
    install_tss()
    call_on_stack_demo()
    cooperative_demo()

    init_pic()
    init_pit()
    unsafe { arch_x86_64.sti() }
    for peek(ffi.address(TICKS)) < TICKS_WANTED {
        unsafe { arch_x86_64.hlt() }
    }
    unsafe { arch_x86_64.cli() }
    print_number(peek(ffi.address(TICKS)))
    println(" timer interrupts")
    println("ticks ok")
    preemptive_demo()
    double_fault_demo()
}

// ---- Stackful cooperative and timer-preempted tasks (ADR 0109) ----
#[align(16)]
static mut TASK_STACK_A [32768]u8
#[align(16)]
static mut TASK_STACK_B [32768]u8
static mut ROOT_CONTEXT arch_x86_64.Context
static mut TASK_A arch_x86_64.Context
static mut TASK_B arch_x86_64.Context
static mut CURRENT_TASK u64
static mut PREEMPTING u64
static mut PREEMPTIONS u64
static mut RAN_A u64
static mut RAN_B u64

fn task_context(id u64) *mut arch_x86_64.Context {
    if id == 1 { return TASK_A }
    return TASK_B
}
fn task_yield() {
    id := peek(ffi.address(CURRENT_TASK))
    next := 3 - id
    poke(ffi.address(CURRENT_TASK), next)
    unsafe { arch_x86_64.context_switch(task_context(id), ffi.to_const(task_context(next))) }
}
fn cooperative_task(id u64) {
    var turn: u64 = 0
    for turn < 3 {
        print_text("coop: task ")
        print_number(id)
        print_text(" turn ")
        print_number(turn)
        newline()
        turn = turn + 1
        if id == 2 && turn == 3 {
            unsafe { arch_x86_64.switch_stack(u64(ffi.address(SIDE_STACK) + 16384), ffi.callback(one_way_entry), 77) }
            panic("finished cooperative task resumed")
        }
        task_yield()
    }
    panic("finished cooperative task resumed")
}
fn preempted_task(id u64) {
    // No yield: only the timer handler can transfer control to the other task.
    if id == 1 { poke(ffi.address(RAN_A), 1) } else { poke(ffi.address(RAN_B), 1) }
    unsafe { arch_x86_64.sti() }
    for true {
        if id == 1 { poke(ffi.address(RAN_A), peek(ffi.address(RAN_A)) | 2) } else { poke(ffi.address(RAN_B), peek(ffi.address(RAN_B)) | 2) }
    }
}
fn initialize_tasks(preempt bool) {
    var entry: *u8 = ffi.callback(cooperative_task)
    if preempt { entry = ffi.callback(preempted_task) }
    unsafe {
        arch_x86_64.context_init(TASK_A, u64(ffi.address(TASK_STACK_A) + 32768), entry, 1)
        arch_x86_64.context_init(TASK_B, u64(ffi.address(TASK_STACK_B) + 32768), entry, 2)
    }
    poke(ffi.address(CURRENT_TASK), 1)
}
fn cooperative_demo() {
    initialize_tasks(false)
    unsafe { arch_x86_64.context_switch(ROOT_CONTEXT, ffi.to_const(TASK_A)) }
    println("coop: contexts restored")
}
fn schedule_tick() {
    if peek(ffi.address(PREEMPTING)) == 0 { return }
    id := peek(ffi.address(CURRENT_TASK))
    print_text("preempt: task ")
    print_number(id)
    newline()
    count := peek(ffi.address(PREEMPTIONS)) + 1
    poke(ffi.address(PREEMPTIONS), count)
    if count == 6 {
        poke(ffi.address(PREEMPTING), 0)
        unsafe { arch_x86_64.context_switch(task_context(id), ffi.to_const(ROOT_CONTEXT)) }
    } else { task_yield() }
}
fn preemptive_demo() {
    initialize_tasks(true)
    poke(ffi.address(PREEMPTING), 1)
    unsafe { arch_x86_64.context_switch(ROOT_CONTEXT, ffi.to_const(TASK_A)) }
    unsafe { arch_x86_64.cli() }
    if peek(ffi.address(RAN_A)) != 3 || peek(ffi.address(RAN_B)) != 3 { panic("preemption did not run both tasks") }
    println("preempt: timer switched both busy tasks")
}

fn smap_demo() {
    unsafe {
        features := arch_x86_64.cpuid(7, 0)
        if (features.ebx & (1 << 20)) == 0 { println("smap: unavailable")
            return
        }
        arch_x86_64.write_cr4(arch_x86_64.read_cr4() | (1 << 21))
        arch_x86_64.stac()
        if (arch_x86_64.read_rflags() & (1 << 18)) == 0 { panic("stac failed") }
        arch_x86_64.clac()
        if (arch_x86_64.read_rflags() & (1 << 18)) != 0 { panic("clac failed") }
        println("smap: stac/clac window ok")
    }
}

static mut ABANDONED_CONTEXT arch_x86_64.Context
fn one_way_entry(arg u64) {
    var marker: u64 = arg
    here := ffi.address(ffi.of(&marker))
    base := ffi.address(SIDE_STACK)
    if arg != 77 || here < base || here >= base + 16384 { panic("switch_stack: bad stack or argument") }
    println("switch_stack: entered new stack without return")
    unsafe { arch_x86_64.context_switch(ABANDONED_CONTEXT, ffi.to_const(ROOT_CONTEXT)) }
    panic("abandoned stack resumed")
}
