// core: the declarations every Tarn module sees (the prelude).
//
// Everything declared `pub` here is visible without an import. Functions
// marked `extern "intrinsic"` have no Tarn body: the compiler implements them,
// but their signatures are ordinary Tarn and are what the type checker,
// documentation, the LSP and agents read (ADR 0020).

/// An optional value: `Some(value)` or `None`. Tarn has no null.
pub enum Option<T> {
    Some(T)
    None
}

/// The result of an operation that can fail. Propagate errors with `try`.
pub enum Result<T, E> {
    Ok(T)
    Err(E)
}

// Combinators (Phase 23A). Ordinary Tarn: conversions stay explicit at the
// call site, e.g. `try store.save().map_err(http.Error.Io)`. Callbacks run at
// most once (`once fn`); non-`move` closure literals adopt that mode.
pub fn Option<T>.is_some(&self) bool {
    match self {
        Some(value) => { return true }
        None => { return false }
    }
}
pub fn Option<T>.is_none(&self) bool { return !self.is_some() }
/// The value, or `fallback` (which is destroyed when unused).
pub fn Option<T>.unwrap_or(self, fallback T) T {
    match self {
        Some(value) => { return value }
        None => { return fallback }
    }
}
/// The value; panics when empty.
pub fn Option<T>.unwrap(self) T {
    match self {
        Some(value) => { return value }
        None => { panic("called `unwrap` on `None`") }
    }
}
/// The value; panics with `message` when empty.
pub fn Option<T>.expect(self, message string) T {
    match self {
        Some(value) => { return value }
        None => { panic(message) }
    }
}
/// `Ok(value)`, or `Err(error)` when empty.
pub fn Option<T>.ok_or<E>(self, error E) Result<T, E> {
    match self {
        Some(value) => { return Ok(value) }
        None => { return Err(error) }
    }
}
pub fn Option<T>.map<U>(self, f once fn(T) U) Option<U> {
    match self {
        Some(value) => { return Some(f(value)) }
        None => { return None }
    }
}
pub fn Result<T, E>.is_ok(&self) bool {
    match self {
        Ok(value) => { return true }
        Err(error) => { return false }
    }
}
pub fn Result<T, E>.is_err(&self) bool { return !self.is_ok() }
/// The success value; the error is discarded.
pub fn Result<T, E>.ok(self) Option<T> {
    match self {
        Ok(value) => { return Some(value) }
        Err(error) => { return None }
    }
}
/// The success value; panics on an error, which is destroyed.
pub fn Result<T, E>.unwrap(self) T {
    match self {
        Ok(value) => { return value }
        Err(error) => { panic("called `unwrap` on `Err`") }
    }
}
/// The success value; panics with `message` on an error.
pub fn Result<T, E>.expect(self, message string) T {
    match self {
        Ok(value) => { return value }
        Err(error) => { panic(message) }
    }
}
pub fn Result<T, E>.unwrap_or(self, fallback T) T {
    match self {
        Ok(value) => { return value }
        Err(error) => { return fallback }
    }
}
pub fn Result<T, E>.map<U>(self, f once fn(T) U) Result<U, E> {
    match self {
        Ok(value) => { return Ok(f(value)) }
        Err(error) => { return Err(error) }
    }
}
/// Convert the error with `f`; the usual way to change error types for `try`.
pub fn Result<T, E>.map_err<F>(self, f once fn(E) F) Result<T, F> {
    match self {
        Ok(value) => { return Ok(value) }
        Err(error) => { return Err(f(error)) }
    }
}

/// Equality chosen by the type's author (ADR 0022, Phase 26C): `a == b`
/// means `a.eq(&b)` and `a != b` its negation. There is no structural
/// default and no derive; implement it explicitly.
pub interface Eq {
    fn eq(&self, other &Self) bool
}

// Primitive equality: the built-in comparison, so generic code bounded by
// `Eq` accepts primitives (ADR 0060).
impl Eq for i8 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for i16 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for i32 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for i64 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for isize {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for u8 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for u16 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for u32 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for u64 {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for usize {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for bool {
    fn eq(&self, other &Self) bool { return self == other }
}
impl Eq for string {
    fn eq(&self, other &Self) bool { return self == other }
}

// Conditional implementations (ADR 0078): an `Option<T>` is `Eq` exactly
// when `T` is, and so on. `None == None`; values compare by `T.eq`.
impl Eq for Option<T: Eq> {
    fn eq(&self, other &Self) bool {
        match self {
            Some(a) => {
                match other {
                    Some(b) => { return a.eq(b) }
                    None => { return false }
                }
            }
            None => { return other.is_none() }
        }
    }
}
impl Eq for Result<T: Eq, E: Eq> {
    fn eq(&self, other &Self) bool {
        match self {
            Ok(a) => {
                match other {
                    Ok(b) => { return a.eq(b) }
                    Err(_) => { return false }
                }
            }
            Err(a) => {
                match other {
                    Ok(_) => { return false }
                    Err(b) => { return a.eq(b) }
                }
            }
        }
    }
}

/// A 64-bit hash consistent with `Eq`: `a.eq(&b)` implies `a.hash() ==
/// b.hash()`. Not cryptographic and not stable across Tarn versions; do not
/// persist it. Used by `collections.Map` and `collections.Set` (ADR 0060).
pub interface Hash {
    fn hash(&self) u64
}

/// Finalizer of splitmix64: spreads integer keys over all 64 bits.
fn _mix(value u64) u64 {
    var x = value ^ (value >> 30)
    x = x.wrapping_mul(13787848793156543929)
    x = x ^ (x >> 27)
    x = x.wrapping_mul(10723151780598845931)
    return x ^ (x >> 31)
}

impl Hash for u64 {
    fn hash(&self) u64 { return _mix(*self) }
}
// Checked numeric conversions cannot cast a negative signed value to u64.
// Encode its two's-complement bits without negating the minimum i64.
fn _signed_hash(value i64) u64 {
    if value < 0 { return _mix(u64(-(value + 1)) ^ 18446744073709551615) }
    return _mix(u64(value))
}
impl Hash for i8 { fn hash(&self) u64 { return _signed_hash(i64(*self)) } }
impl Hash for i16 { fn hash(&self) u64 { return _signed_hash(i64(*self)) } }
impl Hash for i32 { fn hash(&self) u64 { return _signed_hash(i64(*self)) } }
impl Hash for i64 { fn hash(&self) u64 { return _signed_hash(*self) } }
impl Hash for isize { fn hash(&self) u64 { return _signed_hash(i64(*self)) } }
impl Hash for u8 {
    fn hash(&self) u64 { return _mix(u64(*self)) }
}
impl Hash for u16 {
    fn hash(&self) u64 { return _mix(u64(*self)) }
}
impl Hash for u32 {
    fn hash(&self) u64 { return _mix(u64(*self)) }
}
impl Hash for usize {
    fn hash(&self) u64 { return _mix(u64(*self)) }
}
impl Hash for bool {
    fn hash(&self) u64 {
        if *self { return _mix(1) }
        return _mix(0)
    }
}

/// FNV-1a over the UTF-8 bytes, finished with the integer mixer.
impl Hash for string {
    fn hash(&self) u64 {
        data := self.bytes()
        var h: u64 = 14695981039346656037
        var i: usize = 0
        for i < data.len() {
            h = (h ^ u64(data[i])).wrapping_mul(1099511628211)
            i = i + 1
        }
        return _mix(h)
    }
}

/// `None` and `Some(v)` hash differently even when `v` hashes to zero.
impl Hash for Option<T: Hash> {
    fn hash(&self) u64 {
        match self {
            Some(value) => { return _mix(value.hash() ^ 6148914691236517205) }
            None => { return _mix(0) }
        }
    }
}

/// Capability: values of this type are copied instead of moved.
///
/// Not implemented with `impl`: primitives are `Copy`, and a struct or enum is
/// `Copy` when declared with the `copy` keyword (ADR 0021). Usable as a bound:
/// `copy struct Point<T: Copy> {` with fields `x T` and `y T` on their own lines.
pub interface Copy {
}

/// Compile-time capability: ownership may cross a native task boundary.
pub interface Transfer {
}

/// Compile-time capability: shared access may occur concurrently.
pub interface Share {
}

// ---------------------------------------------------------------- string

/// Length in bytes.
pub extern "intrinsic" fn string.len(&self) usize
pub extern "intrinsic" fn string.is_empty(&self) bool
pub extern "intrinsic" fn string.clone(&self) string

/// Observe the same string; the result borrows the receiver.
pub fn string.view(&self) &string { return self }
/// Select a borrowed string; either input may supply the result.
pub fn string.choose(&self, other &string, first bool) &string {
    if first { return self }
    return other
}

