pub extern "intrinsic" fn i64.wrapping_sub(self, other i64) i64
pub extern "intrinsic" fn i64.wrapping_mul(self, other i64) i64
pub extern "intrinsic" fn isize.wrapping_add(self, other isize) isize
pub extern "intrinsic" fn isize.wrapping_sub(self, other isize) isize
pub extern "intrinsic" fn isize.wrapping_mul(self, other isize) isize
