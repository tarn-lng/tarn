/// Unique native task; joining consumes it, destruction joins unused tasks.
pub struct Task<R> {
    handle usize
}
pub extern "intrinsic" fn Task<R>.join(self) R

// ------------------------------------------------ growable vector (phase 14A)

/// Owned growable sequence. Elements live in owned heap storage; destroying the
/// vector destroys every remaining element once, in index order, then frees the
/// storage. Capacity grows geometrically (4, 8, 16, ...). Out-of-range indices
/// abort. `[0]T` is a zero-size marker: capabilities, reference containment and
/// copy semantics follow the element type.
pub struct Vec<T> {
    storage usize
    count usize
    capacity usize
    elements [0]T
}
pub extern "intrinsic" fn Vec<T>.new() Vec<T>
/// Empty vector with room for `capacity` elements, allocated once.
pub extern "intrinsic" fn Vec<T>.with_capacity(capacity usize) Vec<T>
pub extern "intrinsic" fn Vec<T>.len(&self) usize
pub extern "intrinsic" fn Vec<T>.push(&mut self, value T)
/// Moves the last element out, if any.
pub extern "intrinsic" fn Vec<T>.pop(&mut self) Option<T>
pub extern "intrinsic" fn Vec<T>.get(&self, index usize) &T
/// Copy out an element; requires `T: Copy` (trusted obligation, like MutexGuard.read).
pub extern "intrinsic" fn Vec<T>.at(&self, index usize) T
pub extern "intrinsic" fn Vec<T>.get_mut(&mut self, index usize) &mut T
/// Installs `value` at `index` and moves the previous element out.
pub extern "intrinsic" fn Vec<T>.replace(&mut self, index usize, value T) T
/// Exchanges two elements; aborts if either index is out of bounds.
pub extern "intrinsic" fn Vec<T>.swap(&mut self, a usize, b usize)
/// Moves the element at `index` out; the last element takes its place.
pub extern "intrinsic" fn Vec<T>.swap_remove(&mut self, index usize) T
pub extern "intrinsic" fn Vec<T>.is_empty(&self) bool
/// Borrow every element as a slice; the slice borrows the vector, so the vector
/// cannot grow, shrink or move while the slice is live.
pub extern "intrinsic" fn Vec<T>.as_slice(&self) &[]T
/// Append copies of `items` with one bulk copy; elements must be Copy.
pub extern "intrinsic" fn Vec<T>.extend_from_slice(&mut self, items &[]T)
pub extern "intrinsic" fn Vec<T>.as_mut_slice(&mut self) &mut []T

// ------------------------------------------------ synchronization (phase 11C)

/// Unique synchronized owner. Share and Transfer both require T: Transfer.
/// The payload is private: only a live lock guard can access it.
pub struct Mutex<T> {
    native usize
    payload T
}
pub extern "intrinsic" fn Mutex<T>.new(value T) Mutex<T>
/// Nonrecursive locking. Panic aborts; there is no poisoning.
pub extern "intrinsic" fn Mutex<T>.lock(&self) MutexGuard<T>

/// Unique, non-Copy, non-Transfer, non-Share synchronization authority.
/// Its loan borrows the mutex until verified destruction unlocks it.
pub struct MutexGuard<T> {
    native usize
    payload usize
}
/// Borrow exclusive payload access, bounded by this guard's lifetime.
pub extern "intrinsic" fn MutexGuard<T>.value(&mut self) &mut T
/// Copy a Copy payload while locked.
pub extern "intrinsic" fn MutexGuard<T>.read(&self) T
/// Transfer the new payload in and the old payload out, without duplication.
pub extern "intrinsic" fn MutexGuard<T>.replace(&mut self, value T) T

/// Unique synchronized storage: Transfer and Share, never Copy.
/// All operations are sequentially consistent. No ordinary scalar projection.
pub struct AtomicBool { native usize }
pub extern "intrinsic" fn AtomicBool.new(value bool) AtomicBool
pub extern "intrinsic" fn AtomicBool.load(&self) bool
pub extern "intrinsic" fn AtomicBool.store(&self, value bool)
pub extern "intrinsic" fn AtomicBool.swap(&self, value bool) bool
/// Strong comparison: true exactly when expected matched and replacement occurred.
pub extern "intrinsic" fn AtomicBool.compare_exchange(&self, expected bool, value bool) bool

