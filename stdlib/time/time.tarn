// Monotonic time (Phase 14B, ADR 0039). Timers are readiness sources on the
// executor's Poll; there is no timer thread and no second wake mechanism.
import "io"
/// Monotonic span of time, millisecond resolution.
pub copy struct Duration { millis u64 }
pub fn Duration.milliseconds(count u64) Duration { return Duration{millis: count} }
/// Overflow aborts (checked arithmetic).
pub fn Duration.seconds(count u64) Duration { return Duration{millis: count * 1000} }
pub fn Duration.as_millis(self) u64 { return self.millis }
/// One-shot monotonic timer: an owned pollable descriptor on the shared readiness
/// Poll. Not Share; moving it moves the descriptor; destruction closes it once.
pub struct Timer { fd i32 }
extern "intrinsic" fn _timer_new(millis i64) io._Raw
extern "intrinsic" fn _timer_read(fd i32) io._Raw
pub fn Timer.after(duration Duration) Result<Timer, io.Error> {
    raw := try io._check(_timer_new(i64(duration.millis)))
    return Ok(Timer{fd: i32(raw.value)})
}
pub fn poll_timer(waker &io.Waker, timer &mut Timer) io.Progress<Result<void, io.Error>> {
    match io._check(_timer_read(timer.fd)) {
        Ok(raw) => { return io.Progress.Ready(Ok(())) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, timer.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match io._check(_timer_read(timer.fd)) {
        Ok(raw) => { return io.Progress.Ready(Ok(())) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub async fn Timer.wait_async(&mut self) Result<void, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<void, io.Error>> { return io._leaf(waker, poll_timer(waker, self)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn sleep(duration Duration) Result<void, io.Error> {
    var timer = try Timer.after(duration)
    return await timer.wait_async()
}

// Two signed 64-bit fields: seconds, nanoseconds (ADRs 0060, 0098).
import "ffi"
extern "C" fn tarn_clock_read(clock i32, out *mut i64) i32
extern "C" fn __errno_location() *u8
pub copy struct Instant { seconds u64
 nanos u32 }
/// Unix seconds plus a nanosecond fraction, without calendar/time-zone policy.
pub copy struct Timestamp { pub unix_seconds i64
 pub nanos u32 }
fn _clock(which i32) Result<Timestamp, io.Error> {
    var fields = [2]i64{0, 0}
    var result: i32 = 0
    unsafe { result = tarn_clock_read(which, ffi.slice_mut(&mut fields)) }
    if result != 0 {
        var bytes: Vec<u8> = Vec.new()
        unsafe { bytes = ffi.copy_bytes(__errno_location(), 4) }
        code := i32(bytes.at(0)) + i32(bytes.at(1)) * 256 + i32(bytes.at(2)) * 65536 + i32(bytes.at(3)) * 16777216
        return Err(io.Error.from_os(code))
    }
    return Ok(Timestamp{unix_seconds: fields[0], nanos: u32(fields[1])})
}
pub fn Instant.now() Result<Instant, io.Error> {
    stamp := try _clock(1)
    return Ok(Instant{seconds: u64(stamp.unix_seconds), nanos: stamp.nanos})
}
/// Millisecond duration, rounded down. Rejects reversed instants.
pub fn Instant.since(self, earlier Instant) Result<Duration, io.Error> {
    if self.seconds < earlier.seconds { return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
    var seconds = self.seconds - earlier.seconds
    var nanos = i64(self.nanos) - i64(earlier.nanos)
    if nanos < 0 {
        if seconds == 0 { return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
        seconds = seconds - 1
        nanos = nanos + 1000000000
    }
    return Ok(Duration.milliseconds(seconds * 1000 + u64(nanos) / 1000000))
}
pub fn Instant.elapsed(self) Result<Duration, io.Error> { return (try Instant.now()).since(self) }
pub fn now_utc() Result<Timestamp, io.Error> { return _clock(0) }

extern "C" fn nanosleep(request *i64, remaining *mut i64) i32
/// Blocks the current native task. Retries interrupted sleeps with the
/// remaining duration; no executor or global scheduler is involved.
pub fn sleep_blocking(duration Duration) Result<void, io.Error> {
    if duration.millis / 1000 > 9223372036854775807 { return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
    var request = [2]i64{i64(duration.millis / 1000), i64(duration.millis % 1000) * 1000000}
    for {
        var remaining = [2]i64{0, 0}
        var result: i32 = 0
        unsafe { result = nanosleep(ffi.slice(&request), ffi.slice_mut(&mut remaining)) }
        if result == 0 { return Ok(()) }
        var bytes: Vec<u8> = Vec.new()
        unsafe { bytes = ffi.copy_bytes(__errno_location(), 4) }
        code := i32(bytes.at(0)) + i32(bytes.at(1)) * 256 + i32(bytes.at(2)) * 65536 + i32(bytes.at(3)) * 16777216
        if code != 4 { return Err(io.Error.from_os(code)) }
        request = remaining
    }
}
