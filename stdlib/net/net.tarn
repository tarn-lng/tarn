pub fn Event.empty() Event {
    return Event{token: Token{value: 0}, readable: false, writable: false, error: false, hangup: false}
}
pub fn Token.same(self, other Token) bool { return self.value == other.value }
fn _set_nonblocking(fd i32, enabled bool) Result<void, io.Error> {
    for {
        raw := _nonblocking(fd, enabled)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
pub fn TcpListener.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn UnixStream.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.stream.fd, enabled) }
pub fn UdpSocket.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return _set_nonblocking(self.fd, enabled) }
pub fn TcpStream.connect_nonblocking(address &string) Result<Connecting, io.Error> { return TcpStream.connect_nonblocking_addr(try resolve(address)) }
pub fn TcpStream.connect_nonblocking_addr(address SocketAddr) Result<Connecting, io.Error> {
    raw := try _open(address, false)
    var stream = TcpStream{fd: i32(raw.value)}
    try stream.set_nonblocking(true)
    status := _connect(stream.fd, address)
    if status.domain == 0 && (status.code == 115 || status.code == 4) {
        return Ok(Connecting{stream: stream, status: 115})
    }
    try io._check(status)
    return Ok(Connecting{stream: stream, status: 0})
}
pub fn Connecting.poll_connected(&mut self) Result<bool, io.Error> {
    if self.status == 0 { return Ok(true) }
    if self.status != 115 { return Err(_connection_error(self.status)) }
    for {
        raw := _connected(self.stream.fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        if raw.domain == 0 && raw.code == 11 { return Ok(false) }
        self.status = raw.code
        try io._check(raw)
        return Ok(true)
    }
}
pub fn Connecting.into_stream(self) Result<TcpStream, io.Error> {
    if self.status != 0 { return Err(_connection_error(self.status)) }
    return Ok(self.stream)
}
pub fn Poll.new() Result<Poll, io.Error> {
    for {
        raw := _poll_new()
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(Poll{handle: usize(checked.value)})
    }
}
fn _interest(value Interest) i32 {
    match value {
        Interest.Readable => { return 1 }
        Interest.Writable => { return 2 }
        Interest.ReadableWritable => { return 3 }
    }
}
fn _registration(handle usize, fd i32, op i32, interest Interest, token Token) Result<Token, io.Error> {
    for {
        raw := _poll_ctl(handle, fd, op, _interest(interest), token.value)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(Token{value: u64(checked.value)})
    }
}
pub fn Poll.register_listener(&mut self, socket &TcpListener, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_stream(&mut self, socket &TcpStream, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_udp(&mut self, socket &UdpSocket, interest Interest) Result<Token, io.Error> { return _registration(self.handle, socket.fd, 0, interest, Token{value: 0}) }
pub fn Poll.register_connecting(&mut self, socket &Connecting) Result<Token, io.Error> { return _registration(self.handle, socket.stream.fd, 0, Interest.Writable, Token{value: 0}) }
pub fn Poll.modify_listener(&mut self, socket &TcpListener, token Token, interest Interest) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 1, interest, token)
    return Ok(())
}
