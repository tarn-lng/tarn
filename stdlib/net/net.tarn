/// Connects to a filesystem socket path. A missing path is NotFound, a
/// refused permission PermissionDenied, and an empty, NUL-containing or
/// over-long path (108 bytes or more) InvalidAddress.
pub fn UnixStream.connect(path &string) Result<UnixStream, io.Error> {
    for {
        raw := _connect_unix(path)
        if raw.code == 4 && raw.domain == 0 { continue }
        if raw.domain == 0 && raw.code == 2 { return Err(io.Error{kind: io.ErrorKind.NotFound, code: 2, domain: 0}) }
        if raw.domain == 0 && (raw.code == 1 || raw.code == 13) { return Err(io.Error{kind: io.ErrorKind.PermissionDenied, code: raw.code, domain: 0}) }
        checked := try io._check(raw)
        return Ok(UnixStream{stream: TcpStream{fd: i32(checked.value)}})
    }
}
/// A connected pair with no filesystem name (socketpair). Both ends are
/// close-on-exec; hand one to a child with `process.Command.pass`.
pub fn UnixStream.pair() Result<UnixPair, io.Error> {
    raw := try io._check(_pair_unix())
    second := i32(raw.address[0]) + i32(raw.address[1]) * 256 + i32(raw.address[2]) * 65536 + i32(raw.address[3]) * 16777216
    return Ok(UnixPair{first: UnixStream{stream: TcpStream{fd: i32(raw.value)}}, second: UnixStream{stream: TcpStream{fd: second}}})
}
pub fn UnixStream.read(&mut self, buffer &mut []u8) Result<usize, io.Error> { return self.stream.read(buffer) }
pub fn UnixStream.write(&mut self, buffer &[]u8) Result<usize, io.Error> { return self.stream.write(buffer) }
pub fn UnixStream.write_all(&mut self, buffer &[]u8) Result<void, io.Error> { return self.stream.write_all(buffer) }
pub fn UnixStream.shutdown(&mut self, how Shutdown) Result<void, io.Error> { return self.stream.shutdown(how) }
pub fn UnixStream.close(self) Result<void, io.Error> { return self.stream.close() }
/// The descriptor for registering with a foreign event loop (for example
/// GLib's `g_unix_fd_add_full`). It is borrowed: the stream still owns and
/// closes it. Remove any foreign registration before the stream is closed or
/// destroyed, and never close the number yourself.
pub fn UnixStream.raw_fd(&self) i32 { return self.stream.fd }
fn _open(address SocketAddr, udp bool) Result<io._Raw, io.Error> {
    for {
        raw := _socket(address, udp)
        if raw.code == 4 && raw.domain == 0 { continue }
        return io._check(raw)
    }
}
fn _bound(fd i32, address SocketAddr) Result<void, io.Error> {
    for {
        raw := _bind(fd, address)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
fn _listening(fd i32) Result<void, io.Error> {
    for {
        raw := _listen(fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
// Level-triggered readiness. Tokens are observations, never socket authority.
pub struct Poll { handle usize }
pub copy struct Token { value u64 }
pub copy enum Interest {
    Readable
    Writable
    ReadableWritable
}
pub copy struct Event {
    pub token Token
    pub readable bool
    pub writable bool
    pub error bool
    pub hangup bool
}
pub struct Connecting {
    stream TcpStream
    status i32
}
