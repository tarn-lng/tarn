// Blocking and explicit nonblocking Linux networking. Opaque descriptors are owned, Transfer, not Share.
pub struct TcpListener { fd i32 }
pub struct TcpStream { fd i32 }
pub struct UdpSocket { fd i32 }
/// A connected Unix-domain stream socket (ADR 0069). It owns a verified
/// descriptor owner, so it is non-Copy, Transfer and not Share, and its
/// destruction closes the descriptor exactly once.
pub struct UnixStream { stream TcpStream }
/// Two connected ends from `UnixStream.pair()`; move each field out to use it.
pub struct UnixPair {
    pub first UnixStream
    pub second UnixStream
}
