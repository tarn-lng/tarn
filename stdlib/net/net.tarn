    return Ok(())
}
pub fn Poll.register_unix(&mut self, socket &UnixStream, interest Interest) Result<Token, io.Error> { return self.register_stream(&socket.stream, interest) }
pub fn Poll.modify_unix(&mut self, socket &UnixStream, token Token, interest Interest) Result<void, io.Error> { return self.modify_stream(&socket.stream, token, interest) }
pub fn Poll.deregister_unix(&mut self, socket &UnixStream, token Token) Result<void, io.Error> { return self.deregister_stream(&socket.stream, token) }
pub fn Poll.wait(&mut self, events &mut []Event, timeout i32) Result<usize, io.Error> {
    if timeout < -1 || events.len() == 0 { return Err(io.Error{kind: io.ErrorKind.InvalidAddress, code: 22, domain: 0}) }
    var remaining = timeout
    var deadline = i64(0)
    if timeout > 0 { deadline = (try io._check(io._now())).value + i64(timeout) }
    for {
        raw := _poll_wait(self.handle, events, remaining)
        if raw.domain == 0 && raw.code == 4 {
            if timeout > 0 {
                now := (try io._check(io._now())).value
                if now >= deadline { return Ok(0) }
                remaining = i32(deadline - now)
            }
            continue
        }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
pub fn Poll.close(self) Result<void, io.Error> {
    try io._check(_close_poll(self))
    return Ok(())
}
fn _connection_error(code i32) io.Error {
    var kind = io.ErrorKind.OtherOs
    if code == 115 { kind = io.ErrorKind.WouldBlock }
    if code == 111 { kind = io.ErrorKind.ConnectionRefused }
    if code == 104 { kind = io.ErrorKind.ConnectionReset }
    if code == 110 { kind = io.ErrorKind.TimedOut }
    return io.Error{kind: kind, code: code, domain: 0}
}
fn _require_nonblocking(fd i32) Result<void, io.Error> {
    for {
        raw := _mode(fd)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        if checked.value == 0 { return Err(io.Error{kind: io.ErrorKind.InvalidAddress, code: 22, domain: 0}) }
        return Ok(())
    }
}
pub fn poll_read(waker &io.Waker, stream &mut TcpStream, buffer &mut []u8) io.Progress<Result<usize, io.Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, stream.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.read(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_write(waker &io.Waker, stream &mut TcpStream, buffer &[]u8) io.Progress<Result<usize, io.Error>> {
    match _require_nonblocking(stream.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, stream.fd, 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match stream.write(buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_accept(waker &io.Waker, listener &mut TcpListener) io.Progress<Result<TcpStream, io.Error>> {
    match _require_nonblocking(listener.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return io.Progress.Ready(Ok(stream)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, listener.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match listener.accept() {
        Ok(stream) => { return io.Progress.Ready(Ok(stream)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_connect(waker &io.Waker, connecting &mut Connecting) io.Progress<Result<void, io.Error>> {
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return io.Progress.Ready(Ok(())) } }
        Err(error) => { return io.Progress.Ready(Err(error)) }
    }
    match io._arm(waker, connecting.stream.fd, 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match connecting.poll_connected() {
        Ok(complete) => { if complete { return io.Progress.Ready(Ok(())) } }
        Err(error) => { return io.Progress.Ready(Err(error)) }
    }
    return io.Progress.Pending
}
pub fn poll_recv(waker &io.Waker, socket &mut UdpSocket, buffer &mut []u8) io.Progress<Result<RecvFrom, io.Error>> {
    match _require_nonblocking(socket.fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return io.Progress.Ready(Ok(packet)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, socket.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match socket.recv_from(buffer) {
        Ok(packet) => { return io.Progress.Ready(Ok(packet)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
// Explicit async I/O over the Phase-12C poll functions. Blocking methods keep
// their names and behavior; these never block the executor. They require
// nonblocking sockets, exactly like the manual operations.
pub async fn TcpStream.read_async(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_read(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn TcpStream.write_async(&mut self, buffer &[]u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_write(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
// At most one successful write per poll; partial progress wakes the same
// Waker before parking, so the next executor turn continues (fairness).
pub async fn TcpStream.write_all_async(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for {
        if offset == buffer.len() { return Ok(()) }
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> {
            match io._leaf(waker, poll_write(waker, self, &buffer[offset..])) {
                io.Progress.Ready(result) => match result {
                    Ok(count) => {
                        if count != 0 && offset + count != buffer.len() { io._wake(waker) }
                        return io.Progress.Ready(Ok(count))
                    }
                    Err(error) => { return io.Progress.Ready(Err(error)) }
                }
                io.Progress.Pending => { return io.Progress.Pending }
            }
        }) {
            io.Progress.Ready(result) => {
                count := try result
                if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
                offset = offset + count
            }
            io.Progress.Pending => {}
        }
        if offset != buffer.len() { io._async_park() }
    }
}
pub async fn TcpListener.accept_async(&mut self) Result<TcpStream, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<TcpStream, io.Error>> { return io._leaf(waker, poll_accept(waker, self)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn Connecting.finish_async(&mut self) Result<void, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<void, io.Error>> { return io._leaf(waker, poll_connect(waker, self)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn UdpSocket.recv_from_async(&mut self, buffer &mut []u8) Result<RecvFrom, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<RecvFrom, io.Error>> { return io._leaf(waker, poll_recv(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
fn _zero_fill(buffer &mut Vec<u8>, size usize) {
    for {
        if buffer.len() >= size { return }
        buffer.push(0)
    }
}
fn _copy_bytes(target &mut []u8, source &[]u8) {
    var index = usize(0)
    for {
        if index == source.len() { return }
        target[index] = source[index]
        index = index + 1
    }
}
/// Owned read buffer. Buffered bytes are `buffer[start..end]`.
pub struct BufferedReader {
    buffer Vec<u8>
    start usize
    end usize
}
/// A zero capacity aborts.
pub fn BufferedReader.new(capacity usize) BufferedReader {
    if capacity == 0 { panic("buffer capacity must be positive") }
    var buffer = Vec.new()
    _zero_fill(&mut buffer, capacity)
    return BufferedReader{buffer: buffer, start: 0, end: 0}
}
pub fn BufferedReader.buffered(&self) usize { return self.end - self.start }
pub fn BufferedReader.capacity(&self) usize { return self.buffer.len() }
// Make room after `end`: reuse an empty buffer, move unread bytes to the
// front, or grow geometrically when the buffer is full of unread bytes.
fn BufferedReader._reserve(&mut self) {
    if self.start == self.end {
        self.start = 0
        self.end = 0
    }
    if self.end != self.buffer.len() { return }
    start := self.start
    count := self.end - start
    if start == 0 {
        size := self.buffer.len() * 2
        _zero_fill(&mut self.buffer, size)
        return
    }
    data := self.buffer.as_mut_slice()
    var index = usize(0)
    for {
        if index == count { break }
        data[index] = data[start + index]
        index = index + 1
    }
    self.start = 0
    self.end = count
}
// One read into free space; Ok(0) is end of stream.
async fn BufferedReader._fill(&mut self, stream &mut TcpStream) Result<usize, io.Error> {
    self._reserve()
    end := self.end
    count := try await stream.read_async(&mut self.buffer.as_mut_slice()[end..])
    self.end = end + count
    return Ok(count)
}
fn BufferedReader._take(&mut self, target &mut []u8) usize {
    start := self.start
    var count = self.end - start
    if target.len() < count { count = target.len() }
    _copy_bytes(target, &self.buffer.as_slice()[start..start + count])
    self.start = start + count
    return count
}
fn BufferedReader._split(&mut self, end usize) Vec<u8> {
    var line = Vec.new()
    var index = self.start
    for {
        if index == end { break }
        line.push(self.buffer.at(index))
        index = index + 1
    }
    self.start = end
    return line
}
/// Buffered bytes first; otherwise at most one read. A request at least as
/// large as the buffer bypasses it. Ok(0) is end of stream.
pub async fn BufferedReader.read(&mut self, stream &mut TcpStream, target &mut []u8) Result<usize, io.Error> {
    if target.len() == 0 { return Ok(0) }
    if self.start == self.end {
        if target.len() >= self.buffer.len() { return await stream.read_async(target) }
        count := try await self._fill(stream)
        if count == 0 { return Ok(0) }
    }
    return Ok(self._take(target))
}
/// Fills `target` completely. End of stream first is UnexpectedEof; bytes
/// already copied into `target` stay consumed.
pub async fn BufferedReader.read_exact(&mut self, stream &mut TcpStream, target &mut []u8) Result<void, io.Error> {
    var done = usize(0)
    for {
        if done == target.len() { return Ok(()) }
        if self.start == self.end {
            count := try await self._fill(stream)
            if count == 0 { return Err(io._fail(io.ErrorKind.UnexpectedEof)) }
        }
        done = done + self._take(&mut target[done..])
    }
}
/// Bytes up to and including `delimiter`, as an owned vector of at most
/// `max` bytes; a longer line is LimitExceeded and stays buffered. At end of
/// stream the remaining bytes are returned without a delimiter; an empty
/// vector means the stream had ended.
pub async fn BufferedReader.read_until(&mut self, stream &mut TcpStream, delimiter u8, max usize) Result<Vec<u8>, io.Error> {
    var scanned = usize(0)
    for {
        var index = self.start + scanned
        for {
            if index == self.end { break }
            if self.buffer.at(index) == delimiter {
                if index + 1 - self.start > max { return Err(io._fail(io.ErrorKind.LimitExceeded)) }
                return Ok(self._split(index + 1))
            }
            index = index + 1
        }
        scanned = self.end - self.start
        if scanned >= max { return Err(io._fail(io.ErrorKind.LimitExceeded)) }
        count := try await self._fill(stream)
        if count == 0 { return Ok(self._split(self.end)) }
    }
}
/// Owned write buffer. Pending bytes are `buffer[start..end]`. Writes are
/// copied in and reach the stream only when the buffer is full, a write is at
/// least as large as the buffer, or `flush` is called. Destruction discards
/// pending bytes without I/O: flushing is always explicit.
pub struct BufferedWriter {
    buffer Vec<u8>
    start usize
    end usize
}
/// A zero capacity aborts.
pub fn BufferedWriter.new(capacity usize) BufferedWriter {
    if capacity == 0 { panic("buffer capacity must be positive") }
    var buffer = Vec.new()
    _zero_fill(&mut buffer, capacity)
    return BufferedWriter{buffer: buffer, start: 0, end: 0}
}
pub fn BufferedWriter.pending(&self) usize { return self.end - self.start }
pub fn BufferedWriter.capacity(&self) usize { return self.buffer.len() }
/// Accepts at least one byte of a non-empty `data`. Flushes first only when
/// the buffer is full; an empty buffer and a large `data` write directly.
pub async fn BufferedWriter.write(&mut self, stream &mut TcpStream, data &[]u8) Result<usize, io.Error> {
    if data.len() == 0 { return Ok(0) }
    if self.end == self.buffer.len() { try await self.flush(stream) }
    if self.start == self.end && data.len() >= self.buffer.len() { return await stream.write_async(data) }
    end := self.end
    var count = self.buffer.len() - end
    if data.len() < count { count = data.len() }
    _copy_bytes(&mut self.buffer.as_mut_slice()[end..end + count], &data[0..count])
    self.end = end + count
    return Ok(count)
}
pub async fn BufferedWriter.write_all(&mut self, stream &mut TcpStream, data &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for {
        if offset == data.len() { return Ok(()) }
        count := try await self.write(stream, &data[offset..])
        if count == 0 { return Err(io._fail(io.ErrorKind.WriteZero)) }
        offset = offset + count
    }
}
/// Writes every pending byte. Partial writes continue where they stopped; on
/// an error exactly the unwritten bytes remain pending.
pub async fn BufferedWriter.flush(&mut self, stream &mut TcpStream) Result<void, io.Error> {
    for {
        if self.start == self.end {
            self.start = 0
            self.end = 0
            return Ok(())
        }
        start := self.start
        end := self.end
        count := try await stream.write_async(&self.buffer.as_slice()[start..end])
        if count == 0 { return Err(io._fail(io.ErrorKind.WriteZero)) }
        self.start = start + count
    }
}

// Persistent TLS client streams (ADR 0066) through system libcurl connect-only
// mode. The native handle owns the descriptor; Tarn borrows it for readiness
// only and never closes it. Owned, Transfer, not Share: one task drives TLS.
pub struct TlsStream {
    native usize
    nonblocking bool
}
pub struct TlsOptions {
    pub timeout_millis u64
    pub ca_file string
}
extern "intrinsic" fn _tls_connect(url &string, ca &string, timeout i64) io._Raw
extern "intrinsic" fn _tls_read(handle usize, buffer &mut []u8, wait bool) io._Raw
extern "intrinsic" fn _tls_write(handle usize, buffer &[]u8, wait bool) io._Raw
extern "intrinsic" fn _tls_fd(handle usize) io._Raw
extern "intrinsic" fn _close_tls(value TlsStream) io._Raw
/// Connection and handshake bound; an empty CA file uses system trust.
pub fn TlsOptions.new() TlsOptions { return TlsOptions{timeout_millis: 30000, ca_file: ""} }
/// `https://host:port` only. Certificate and hostname verification are always
/// on. DNS, TCP and the handshake block the current native task.
pub fn TlsStream.connect(url &string, options &TlsOptions) Result<TlsStream, io.Error> {
    prefix := "https://"
    if url.len() < prefix.len() { return Err(io._fail(io.ErrorKind.InvalidInput)) }
    for i in 0..prefix.len() {
        if url.bytes()[i] != prefix.bytes()[i] { return Err(io._fail(io.ErrorKind.InvalidInput)) }
    }
    if options.timeout_millis == 0 || options.timeout_millis > 9223372036854775807 { return Err(io._fail(io.ErrorKind.InvalidInput)) }
    raw := try io._check(_tls_connect(url, &options.ca_file, i64(options.timeout_millis)))
    return Ok(TlsStream{native: usize(raw.value), nonblocking: false})
}
/// PostgreSQL SSLRequest followed by verified TLS on the same connection.
/// `authority` is a DNS name (or bracketed IPv6) and port, with no credentials
/// or path. A refusal of TLS is an error; this method never falls back to TCP.
/// The timeout covers DNS, TCP, SSLRequest and TLS. Empty CA uses system trust.
pub fn TlsStream.connect_postgres(authority &string, options &TlsOptions) Result<TlsStream, io.Error> {
    if options.timeout_millis == 0 || options.timeout_millis > 9223372036854775807 { return Err(io._fail(io.ErrorKind.InvalidInput)) }
    raw := try io._check(_tls_connect(&("postgresql://" + authority), &options.ca_file, i64(options.timeout_millis)))
    return Ok(TlsStream{native: usize(raw.value), nonblocking: false})
}
/// Mode is stream state, not descriptor state: libcurl keeps the descriptor
/// nonblocking, and blocking calls wait for readiness themselves.
pub fn TlsStream.set_nonblocking(&mut self, enabled bool) { self.nonblocking = enabled }
/// One partial read; zero is orderly EOF. After any error other than
/// WouldBlock the stream is failed and every later transfer fails.
pub fn TlsStream.read(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    checked := try io._check(_tls_read(self.native, buffer, !self.nonblocking))
    return Ok(usize(checked.value))
}
pub fn TlsStream.write(&mut self, buffer &[]u8) Result<usize, io.Error> {
    checked := try io._check(_tls_write(self.native, buffer, !self.nonblocking))
    return Ok(usize(checked.value))
}
pub fn TlsStream.write_all(&mut self, buffer &[]u8) Result<void, io.Error> {
    if self.nonblocking { return Err(io.Error{kind: io.ErrorKind.WouldBlock, code: 81, domain: 5}) }
    var offset = usize(0)
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
/// Consuming close; ownership ends even if cleanup reports nothing.
pub fn TlsStream.close(self) Result<void, io.Error> {
    try io._check(_close_tls(self))
    return Ok(())
}
fn _tls_descriptor(stream &TlsStream) i32 { return i32(_tls_fd(stream.native).value) }
pub fn Poll.register_tls(&mut self, stream &TlsStream, interest Interest) Result<Token, io.Error> { return _registration(self.handle, _tls_descriptor(stream), 0, interest, Token{value: 0}) }
pub fn Poll.modify_tls(&mut self, stream &TlsStream, token Token, interest Interest) Result<void, io.Error> {
    try _registration(self.handle, _tls_descriptor(stream), 1, interest, token)
    return Ok(())
}
pub fn Poll.deregister_tls(&mut self, stream &TlsStream, token Token) Result<void, io.Error> {
    try _registration(self.handle, _tls_descriptor(stream), 2, Interest.Readable, token)
    return Ok(())
}
// TLS may hold decrypted bytes while the descriptor is not readable, so a
// poll always attempts the transfer before arming and again after arming.
pub fn poll_tls_read(waker &io.Waker, stream &mut TlsStream, buffer &mut []u8) io.Progress<Result<usize, io.Error>> {
    match io._check(_tls_read(stream.native, buffer, false)) {
        Ok(raw) => { return io.Progress.Ready(Ok(usize(raw.value))) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, _tls_descriptor(stream), 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match io._check(_tls_read(stream.native, buffer, false)) {
        Ok(raw) => { return io.Progress.Ready(Ok(usize(raw.value))) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
pub fn poll_tls_write(waker &io.Waker, stream &mut TlsStream, buffer &[]u8) io.Progress<Result<usize, io.Error>> {
    match io._check(_tls_write(stream.native, buffer, false)) {
        Ok(raw) => { return io.Progress.Ready(Ok(usize(raw.value))) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, _tls_descriptor(stream), 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match io._check(_tls_write(stream.native, buffer, false)) {
        Ok(raw) => { return io.Progress.Ready(Ok(usize(raw.value))) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
// Async helpers never block the executor, whatever the stream's mode.
pub async fn TlsStream.read_async(&mut self, buffer &mut []u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_tls_read(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn TlsStream.write_async(&mut self, buffer &[]u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, poll_tls_write(waker, self, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn TlsStream.write_all_async(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for offset < buffer.len() {
        count := try await self.write_async(&buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
