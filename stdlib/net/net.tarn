pub fn SocketAddr.port(&self) u16 { return u16(self.data[16]) * 256 + u16(self.data[17]) }
pub fn SocketAddr.is_ipv4(&self) bool { return self.data[18] == 4 }
pub fn SocketAddr.is_ipv6(&self) bool { return self.data[18] == 6 }
pub fn SocketAddr.with_port(self, port u16) SocketAddr {
    var result = self
    result.data[16] = u8(port / 256)
    result.data[17] = u8(port % 256)
    return result
}
pub fn SocketAddr.ip(&self) IpAddr {
    if self.is_ipv4() { return IpAddr.V4([4]u8{self.data[0], self.data[1], self.data[2], self.data[3]}) }
    return IpAddr.V6([16]u8{self.data[0], self.data[1], self.data[2], self.data[3], self.data[4], self.data[5], self.data[6], self.data[7], self.data[8], self.data[9], self.data[10], self.data[11], self.data[12], self.data[13], self.data[14], self.data[15]})
}
pub fn resolve(address &string) Result<SocketAddr, io.Error> {
    for {
        raw := _resolve(address)
        if raw.domain == 0 && raw.code == 4 { continue }
        checked := try io._check(raw)
        return Ok(SocketAddr{data: checked.address})
    }
}
pub fn listen_tcp(address &string) Result<TcpListener, io.Error> { return TcpListener.bind(address) }
pub fn TcpListener.bind(address &string) Result<TcpListener, io.Error> { return TcpListener.bind_addr(try resolve(address)) }
pub fn TcpListener.bind_addr(address SocketAddr) Result<TcpListener, io.Error> {
    raw := try _open(address, false)
    listener := TcpListener{fd: i32(raw.value)}
    try _bound(listener.fd, address)
    try _listening(listener.fd)
    return Ok(listener)
}
extern "C" fn setsockopt(fd i32, level i32, name i32, value *u8, length u32) i32
/// A listener that shares its address with this process's other shared
/// listeners (SO_REUSEPORT): the kernel spreads new connections across them,
/// one accept queue per listener (Phase 30, ADR 0058). Linux limits sharing
/// to the same effective user. Plain `bind` keeps rejecting a second listener.
pub fn TcpListener.bind_shared(address &string) Result<TcpListener, io.Error> {
    target := try resolve(address)
    raw := try _open(target, false)
    listener := TcpListener{fd: i32(raw.value)}
    one := [4]u8{1, 0, 0, 0}
    var result: i32 = 0
    // SOL_SOCKET = 1, SO_REUSEPORT = 15 on Linux.
    unsafe { result = setsockopt(listener.fd, 1, 15, ffi.slice(&one[0..4]), 4) }
    if result != 0 { return Err(io.Error.new(io.ErrorKind.OtherOs)) }
    try _bound(listener.fd, target)
    try _listening(listener.fd)
    return Ok(listener)
}
pub fn TcpListener.accept(&mut self) Result<TcpStream, io.Error> {
    for {
        raw := _accept(self.fd)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(TcpStream{fd: i32(checked.value)})
    }
}
pub fn TcpStream.connect(address &string) Result<TcpStream, io.Error> { return TcpStream.connect_addr(try resolve(address)) }
pub fn TcpStream.connect_addr(address SocketAddr) Result<TcpStream, io.Error> {
    for {
        raw := try _open(address, false)
        stream := TcpStream{fd: i32(raw.value)}
        status := _connect(stream.fd, address)
        if status.code == 4 && status.domain == 0 { continue }
        try io._check(status)
        return Ok(stream)
    }
}
pub fn TcpStream.write_all(&mut self, buffer &[]u8) Result<void, io.Error> {
    for {
        mode := _mode(self.fd)
        if mode.code == 4 && mode.domain == 0 { continue }
        checked := try io._check(mode)
        if checked.value != 0 { return Err(io.Error{kind: io.ErrorKind.WouldBlock, code: 11, domain: 0}) }
        break
    }
    var offset = usize(0)
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
pub fn TcpStream.shutdown(&mut self, how Shutdown) Result<void, io.Error> {
    var direction = i32(2)
    match how {
        Shutdown.Read => { direction = 0 }
        Shutdown.Write => { direction = 1 }
        Shutdown.Both => {}
    }
    for {
        raw := _shutdown(self.fd, direction)
        if raw.code == 4 && raw.domain == 0 { continue }
        try io._check(raw)
        return Ok(())
    }
}
pub fn UdpSocket.bind(address &string) Result<UdpSocket, io.Error> { return UdpSocket.bind_addr(try resolve(address)) }
pub fn UdpSocket.bind_addr(address SocketAddr) Result<UdpSocket, io.Error> {
    raw := try _open(address, true)
    socket := UdpSocket{fd: i32(raw.value)}
    try _bound(socket.fd, address)
    return Ok(socket)
}
pub fn UdpSocket.recv_from(&mut self, buffer &mut []u8) Result<RecvFrom, io.Error> {
    for {
        raw := _recv(self.fd, buffer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(RecvFrom{count: usize(checked.value), peer: SocketAddr{data: checked.address}})
    }
}
pub fn UdpSocket.send_to(&mut self, buffer &[]u8, peer SocketAddr) Result<usize, io.Error> {
    for {
        raw := _send(self.fd, buffer, peer)
        if raw.code == 4 && raw.domain == 0 { continue }
        checked := try io._check(raw)
        return Ok(usize(checked.value))
    }
}
