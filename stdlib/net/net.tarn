    return Ok(())
}
pub fn Poll.deregister_listener(&mut self, socket &TcpListener, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_stream(&mut self, socket &TcpStream, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
    return Ok(())
}
pub fn Poll.deregister_udp(&mut self, socket &UdpSocket, token Token) Result<void, io.Error> {
    try _registration(self.handle, socket.fd, 2, Interest.Readable, token)
