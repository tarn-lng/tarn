// Process arguments and environment for applications (Phase 24A). Ordinary
// Tarn over `fs` and `ffi`: Linux exposes the exact argv in /proc/self/cmdline,
// macOS through a runtime helper (ADR 0098), and libc keeps the environment.
// Text is UTF-8; invalid bytes are reported, never replaced.
import "fs"
import "io"
import "ffi"

extern "C" fn getenv(name *u8) *u8
extern "C" fn strlen(text *u8) usize
extern "C" fn fflush(stream *mut u8) i32
extern "C" fn _exit(status i32)
extern "C" fn access(name *u8, mode i32) i32
extern "C" fn tarn_os_disk_space(name *u8, out *mut u64) i32
extern "C" fn tarn_os_args_block(length *mut u64) *u8
extern "C" fn __errno_location() *u8

/// The program's arguments; index 0 is the program path, as the OS provides
/// it. Fails with InvalidData if an argument is not UTF-8.
pub fn args() Result<Vec<string>, io.Error> {
    var data: Vec<u8> = Vec.new()
    var size = [1]u64{0}
    var provided = false
    unsafe {
        block := tarn_os_args_block(ffi.slice_mut(&mut size))
        if !ffi.is_null(block) {
            data = ffi.copy_bytes(block, usize(size[0]))
            provided = true
        }
    }
    if !provided { data = try fs.read("/proc/self/cmdline") }
    var list: Vec<string> = Vec.new()
    var current: Vec<u8> = Vec.new()
    for byte in data.as_slice() {
        if byte == 0 {
            match string_from_utf8(current.as_slice()) {
                Some(text) => { list.push(text) }
                None => { return Err(io.Error.new(io.ErrorKind.InvalidData)) }
            }
            current = Vec.new()
        } else {
            current.push(byte)
        }
    }
    return Ok(list)
}

/// Raw bytes of an environment variable; None when unset or when the name
/// contains NUL or `=`.
pub fn env_bytes(name &string) Option<Vec<u8>> {
    for byte in name.bytes() {
        if byte == 61 { return None }
    }
    match ffi.CString.new(name) {
        Some(key) => {
            var bytes: Vec<u8> = Vec.new()
            unsafe {
                value := getenv(key.as_ptr())
                if ffi.is_null(value) { return None }
                bytes = ffi.copy_bytes(value, strlen(value))
            }
            return Some(bytes)
        }
        None => { return None }
    }
}

/// An environment variable as text: None when unset, Err(InvalidData) when
/// its value is not UTF-8. Use env_bytes for exact bytes.
pub fn env(name &string) Result<Option<string>, io.Error> {
    match env_bytes(name) {
        Some(bytes) => match string_from_utf8(bytes.as_slice()) {
            Some(text) => { return Ok(Some(text)) }
            None => { return Err(io.Error.new(io.ErrorKind.InvalidData)) }
        }
        None => { return Ok(None) }
    }
}

/// Text value, or `fallback` when unset. Invalid UTF-8 is still an error.
pub fn env_or(name &string, fallback &string) Result<string, io.Error> {
    match try env(name) {
        Some(value) => { return Ok(value) }
        None => { return Ok(fallback.clone()) }
    }
}

/// End the process now with `code` (0–255). Buffered output is flushed, but,
/// as with `panic`, no Tarn value is destroyed: files and sockets are closed
/// by the operating system, unflushed writer buffers are lost.
pub fn exit(code u8) {
    // A Tarn name is also its C symbol, so libc `exit` cannot be declared
    // beside this function: flush stdio streams, then end the process.
    unsafe {
        flushed := fflush(ffi.null())
        _exit(i32(code))
    }
    panic("exit returned")
}

fn last_error() io.Error {
    var bytes: Vec<u8> = Vec.new()
    unsafe { bytes = ffi.copy_bytes(__errno_location(), 4) }
    code := i32(bytes.at(0)) + i32(bytes.at(1)) * 256 + i32(bytes.at(2)) * 65536 + i32(bytes.at(3)) * 16777216
    return io.Error.from_os(code)
}

/// Whether this process may execute `name` (access X_OK): existence plus
/// permission, following symlinks. False for invalid names.
pub fn can_execute(name &string) bool {
    match ffi.CString.new(name) {
        Some(c) => {
            var result: i32 = -1
            unsafe { result = access(c.as_ptr(), 1) }
            return result == 0
        }
        None => { return false }
    }
}

/// Sizes of the filesystem holding a path, in bytes.
pub copy struct DiskSpace {
    pub total u64
    pub free u64
    /// Free space usable without privileges (what `df` shows as available).
    pub available u64
}

pub fn disk_space(name &string) Result<DiskSpace, io.Error> {
    match ffi.CString.new(name) {
        Some(c) => {
            var sizes = [3]u64{0, 0, 0}
            var result: i32 = -1
            unsafe { result = tarn_os_disk_space(c.as_ptr(), ffi.slice_mut(&mut sizes)) }
            if result != 0 { return Err(last_error()) }
            return Ok(DiskSpace{total: sizes[0], free: sizes[1], available: sizes[2]})
        }
        None => { return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
    }
}

