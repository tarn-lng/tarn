extern "intrinsic" fn _write_sctlr_el1(value u64)

/// Read `CPACR_EL1`: Architectural feature access control. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_cpacr_el1() u64 { return _read_cpacr_el1() }
extern "intrinsic" fn _read_cpacr_el1() u64

/// Write `CPACR_EL1`: Architectural feature access control; bits 21:20 = 3 allow FP/SIMD at EL1 and EL0. Interrupt trampolines save the SIMD registers, so this must be set before the first exception. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_cpacr_el1(value u64) { _write_cpacr_el1(value) }
extern "intrinsic" fn _write_cpacr_el1(value u64)

/// Read `CURRENTEL`: Current exception level (bits 3:2). Read-only. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_currentel() u64 { return _read_currentel() }
extern "intrinsic" fn _read_currentel() u64

/// Read `ESR_EL1`: Exception syndrome. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_esr_el1() u64 { return _read_esr_el1() }
extern "intrinsic" fn _read_esr_el1() u64

