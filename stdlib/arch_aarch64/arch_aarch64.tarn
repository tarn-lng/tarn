// AArch64 CPU intrinsics (ADR 0101, P5). Typed, `unsafe` wrappers over tiny
// hand-assembled stubs that the compiler emits into the object of a program
// that calls them (see docs/arch.md). Available only when compiling for an
// aarch64 target; any other target is a compile error. System-register and
// barrier instructions fault in user mode (EL0) on most registers: that is
// the caller's `unsafe` responsibility. A system-register write takes effect
// only after a context-synchronization event: call `isb()` when it matters.
/// Wait for interrupt (`wfi`).
pub unsafe fn wfi() { _wfi() }
extern "intrinsic" fn _wfi()

/// Wait for event (`wfe`).
pub unsafe fn wfe() { _wfe() }
extern "intrinsic" fn _wfe()

/// Instruction synchronization barrier (`isb`).
pub unsafe fn isb() { _isb() }
extern "intrinsic" fn _isb()

/// Data synchronization barrier, full system (`dsb sy`).
pub unsafe fn dsb_sy() { _dsb_sy() }
extern "intrinsic" fn _dsb_sy()

/// Data memory barrier, full system (`dmb sy`).
pub unsafe fn dmb_sy() { _dmb_sy() }
extern "intrinsic" fn _dmb_sy()

/// Unmask IRQ in PSTATE (`msr daifclr, #2`). EL1+.
pub unsafe fn irq_enable() { _irq_enable() }
extern "intrinsic" fn _irq_enable()

/// Mask IRQ in PSTATE (`msr daifset, #2`). EL1+.
pub unsafe fn irq_disable() { _irq_disable() }
extern "intrinsic" fn _irq_disable()

/// Read `DAIF`: Interrupt mask bits (D, A, I, F). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_daif() u64 { return _read_daif() }
extern "intrinsic" fn _read_daif() u64

/// Write `DAIF`: Interrupt mask bits (D, A, I, F). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_daif(value u64) { _write_daif(value) }
extern "intrinsic" fn _write_daif(value u64)

/// Read `VBAR_EL1`: Vector base address of EL1 exceptions. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_vbar_el1() u64 { return _read_vbar_el1() }
extern "intrinsic" fn _read_vbar_el1() u64

/// Write `VBAR_EL1`: Vector base address of EL1 exceptions. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_vbar_el1(value u64) { _write_vbar_el1(value) }
extern "intrinsic" fn _write_vbar_el1(value u64)

/// Read `TTBR0_EL1`: Translation table base 0 (EL1&0 lower VA range). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_ttbr0_el1() u64 { return _read_ttbr0_el1() }
extern "intrinsic" fn _read_ttbr0_el1() u64

/// Write `TTBR0_EL1`: Translation table base 0 (EL1&0 lower VA range). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_ttbr0_el1(value u64) { _write_ttbr0_el1(value) }
extern "intrinsic" fn _write_ttbr0_el1(value u64)

/// Read `TTBR1_EL1`: Translation table base 1 (EL1&0 upper VA range). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_ttbr1_el1() u64 { return _read_ttbr1_el1() }
extern "intrinsic" fn _read_ttbr1_el1() u64

/// Write `TTBR1_EL1`: Translation table base 1 (EL1&0 upper VA range). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_ttbr1_el1(value u64) { _write_ttbr1_el1(value) }
extern "intrinsic" fn _write_ttbr1_el1(value u64)

/// Read `TCR_EL1`: Translation control. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_tcr_el1() u64 { return _read_tcr_el1() }
extern "intrinsic" fn _read_tcr_el1() u64

/// Write `TCR_EL1`: Translation control. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_tcr_el1(value u64) { _write_tcr_el1(value) }
extern "intrinsic" fn _write_tcr_el1(value u64)

