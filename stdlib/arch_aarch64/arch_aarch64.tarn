extern "intrinsic" fn _write_cntv_tval_el0(value u64)

/// Read `CNTFRQ_EL0`: Counter frequency in Hz. Read-only here. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_cntfrq_el0() u64 { return _read_cntfrq_el0() }
extern "intrinsic" fn _read_cntfrq_el0() u64

/// Read `CNTVCT_EL0`: Virtual counter. Read-only. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_cntvct_el0() u64 { return _read_cntvct_el0() }
extern "intrinsic" fn _read_cntvct_el0() u64
