/// Read `SPSR_EL1`: Saved program status. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_spsr_el1() u64 { return _read_spsr_el1() }
extern "intrinsic" fn _read_spsr_el1() u64

