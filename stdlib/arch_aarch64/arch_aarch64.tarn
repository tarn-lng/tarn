pub unsafe fn read_ctr_el0() u64 { return _read_ctr_el0() }
extern "intrinsic" fn _read_ctr_el0() u64

/// Read `DCZID_EL0: `dc zva` block size (bits 3:0 is log2 of words; bit 4 prohibits)`. Read-only.
pub unsafe fn read_dczid_el0() u64 { return _read_dczid_el0() }
extern "intrinsic" fn _read_dczid_el0() u64

/// Read `MIDR_EL1: main ID (implementer, part number)`. Read-only.
pub unsafe fn read_midr_el1() u64 { return _read_midr_el1() }
extern "intrinsic" fn _read_midr_el1() u64

/// Read `MPIDR_EL1: multiprocessor affinity`. Read-only.
pub unsafe fn read_mpidr_el1() u64 { return _read_mpidr_el1() }
extern "intrinsic" fn _read_mpidr_el1() u64

/// Read `PAR_EL1: result of the last `at_*` (bit 0 F = fault, bits 47:12 output page, FST in 6:1 on a fault)`. Read-only.
pub unsafe fn read_par_el1() u64 { return _read_par_el1() }
extern "intrinsic" fn _read_par_el1() u64

/// Read `SP_EL0`: the EL0 stack pointer (`mrs x0, sp_el0`). EL1.
pub unsafe fn read_sp_el0() u64 { return _read_sp_el0() }
extern "intrinsic" fn _read_sp_el0() u64

/// Write `SP_EL0` (`msr sp_el0, x0`). EL1. Requires SPSel = 1; accessing this register with SPSel = 0 is undefined.
pub unsafe fn write_sp_el0(value u64) { _write_sp_el0(value) }
extern "intrinsic" fn _write_sp_el0(value u64)

/// Switch to a new stack, call `entry(arg)` on it and return to the original stack.
/// `entry` is `ffi.callback(f)` of an ordinary `fn f(arg u64)`.
/// The stub pushes x29/x30 on the old stack, keeps the old sp in x29
/// (callee-saved, so `entry` preserves it), sets `sp = stack_top & ~15`,
/// `blr`s `entry` with `x0 = arg`, then restores sp, x29 and x30 and returns.
/// Requires: `stack_top` is one past the end of at least a few KiB of writable
/// normal memory (the stack grows down; nothing at or above it is touched) and
/// `entry` returns normally. With SPSel=1, exceptions use this same stack;
/// with SPSel=0, exceptions use SP_EL1, which the caller must provision.
/// Both execution and exception stacks must stay mapped.
pub unsafe fn call_on_stack(stack_top u64, entry *u8, arg u64) { _call_on_stack(stack_top, entry, arg) }
extern "intrinsic" fn _call_on_stack(stack_top u64, entry *u8, arg u64)

// ---- Exceptions (ADR 0101, P7) -----------------------------------------------
//
// `#[interrupt(slot)]` puts a handler's trampoline in the compiler-generated
// vector table of the `#[vector_table]` function; `ffi.callback(that_function)`
// is the table's address for `write_vbar_el1`. Slots (the table has 16 entries
// of 128 bytes; the table is 2048-byte aligned as VBAR_EL1 requires):
//
//     0-3   current EL, SP_EL0:   synchronous, IRQ, FIQ, SError
//     4-7   current EL, SP_ELx:   synchronous, IRQ, FIQ, SError
//     8-11  lower EL, AArch64:    synchronous, IRQ, FIQ, SError
//     12-15 lower EL, AArch32:    synchronous, IRQ, FIQ, SError
//
// An empty slot is `b .` (the CPU spins), so a stray exception is visible.

/// The register state an `#[interrupt]` handler receives a pointer to: x0..x30,
/// then ELR_EL1, SPSR_EL1 and the stack pointer at the time of the exception
/// (restored to SP_EL0 for EL0t/EL1t). 272 bytes. The 32 SIMD registers are saved
/// right after it and restored too. The handler may change `x`, `elr` and
/// `spsr`: they are written back before `eret`.
pub struct ExceptionFrame {
    x[31]u64
    elr u64
    spsr u64
    sp u64
}

fn frame_word(frame *ExceptionFrame, index usize) u64 {
    base: *u64 := ffi.from_address(ffi.address(frame))
    unsafe { return ffi.read(ffi.offset(base, index)) }
}
fn set_frame_word(frame *mut ExceptionFrame, index usize, value u64) {
    base: *mut u64 := ffi.from_address(ffi.address(frame))
    unsafe { ffi.write(ffi.offset_mut(base, index), value) }
}

/// Saved general register `x<index>`. `index` must be 0..=30 (x30 is the link register); a larger index
/// panics instead of reading ELR/SPSR/SP, which have `frame_elr`, `frame_spsr` and `frame_sp`.
/// Requires: `frame` points at a live `ExceptionFrame`.
pub unsafe fn frame_x(frame *ExceptionFrame, index usize) u64 {
    if index > 30 { panic("frame_x: register index out of range 0..=30") }
    return frame_word(frame, index)
}
/// Change the value `x<index>` has after `eret`. `index` must be 0..=30 (panics otherwise). Requires: the handler's own frame.
pub unsafe fn set_frame_x(frame *mut ExceptionFrame, index usize, value u64) {
    if index > 30 { panic("set_frame_x: register index out of range 0..=30") }
    set_frame_word(frame, index, value)
}
/// The stack pointer of the interrupted code (`SP_EL0` or `SP_EL1`, according to its SPSR.M and SPSel).
/// Restored to SP_EL0 when SPSR.M selects EL0t/EL1t; EL1h uses the original exception stack.
pub unsafe fn frame_sp(frame *ExceptionFrame) u64 { return frame_word(frame, 33) }
/// Saved ELR_EL1: where `eret` resumes.
pub unsafe fn frame_elr(frame *ExceptionFrame) u64 { return frame_word(frame, 31) }
/// Change where `eret` resumes. Requires: the handler's own frame; `elr` is code to run at the saved level.
pub unsafe fn set_frame_elr(frame *mut ExceptionFrame, elr u64) { set_frame_word(frame, 31, elr) }
/// Saved SPSR_EL1.
pub unsafe fn frame_spsr(frame *ExceptionFrame) u64 { return frame_word(frame, 32) }
/// Change the PSTATE `eret` restores. Requires: the handler's own frame and a valid SPSR value.
pub unsafe fn set_frame_spsr(frame *mut ExceptionFrame, spsr u64) { set_frame_word(frame, 32, spsr) }

/// Synchronous EL1 exception, immediate zero; install a vector table first.
pub unsafe fn svc() { _svc() }
extern "intrinsic" fn _svc()

/// Software breakpoint, immediate zero (ESR_EL1.EC 0x3c); the saved ELR points at the `brk` itself,
/// so a handler that returns must advance it with `set_frame_elr`. Install a vector table first.
pub unsafe fn brk() { _brk() }
extern "intrinsic" fn _brk()

/// AArch64 semihosting SYS_EXIT, application exit reason and process status.
/// Requires a debugger/QEMU with semihosting enabled; otherwise traps.
pub unsafe fn semihost_exit(status u64) { _semihost_exit(status) }
extern "intrinsic" fn _semihost_exit(status u64)

