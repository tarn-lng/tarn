// ---- TLB, barriers, cache maintenance, address translation (ADR 0107, T6) ---

/// Invalidate all stage-1 EL1&0 TLB entries of this core (`tlbi vmalle1`). EL1.
/// Follow with `dsb_nsh()` and `isb()`.
pub unsafe fn tlbi_vmalle1() { _tlbi_vmalle1() }
extern "intrinsic" fn _tlbi_vmalle1()

/// As `tlbi_vmalle1` for the Inner Shareable domain (`tlbi vmalle1is`). Follow with `dsb_ish()` and `isb()`.
pub unsafe fn tlbi_vmalle1is() { _tlbi_vmalle1is() }
extern "intrinsic" fn _tlbi_vmalle1is()

/// The `Xt` operand of the by-VA TLB instructions: `VA[55:12]` in bits [43:0], `asid` in bits [63:48].
/// For a global entry (nG = 0) the ASID is ignored by the hardware; pass 0.
pub fn tlbi_operand(va u64, asid u64) u64 { return ((va >> 12) & 0xfffffffffff) | ((asid & 0xffff) << 48) }

/// Invalidate the entries for the page containing `va` and `asid` (`tlbi vae1, Xt`, operand `tlbi_operand(va, asid)`). EL1.
pub unsafe fn tlbi_vae1(va u64, asid u64) { _tlbi_vae1(tlbi_operand(va, asid)) }
extern "intrinsic" fn _tlbi_vae1(operand u64)

/// Inner Shareable `tlbi_vae1` (`tlbi vae1is, Xt`).
pub unsafe fn tlbi_vae1is(va u64, asid u64) { _tlbi_vae1is(tlbi_operand(va, asid)) }
extern "intrinsic" fn _tlbi_vae1is(operand u64)

/// Invalidate only last-level (leaf) entries for `va` and `asid` (`tlbi vale1, Xt`). Walk-cache entries stay.
pub unsafe fn tlbi_vale1(va u64, asid u64) { _tlbi_vale1(tlbi_operand(va, asid)) }
extern "intrinsic" fn _tlbi_vale1(operand u64)

/// Invalidate every entry tagged with `asid` (`tlbi aside1, Xt`, ASID in bits [63:48]). EL1.
pub unsafe fn tlbi_aside1(asid u64) { _tlbi_aside1((asid & 0xffff) << 48) }
extern "intrinsic" fn _tlbi_aside1(operand u64)

/// Data synchronization barrier, Inner Shareable, loads and stores (`dsb ish`).
pub unsafe fn dsb_ish() { _dsb_ish() }
extern "intrinsic" fn _dsb_ish()

/// Data synchronization barrier, Inner Shareable, stores only (`dsb ishst`).
pub unsafe fn dsb_ishst() { _dsb_ishst() }
extern "intrinsic" fn _dsb_ishst()

/// Data synchronization barrier, Non-shareable (`dsb nsh`).
pub unsafe fn dsb_nsh() { _dsb_nsh() }
extern "intrinsic" fn _dsb_nsh()

/// Data synchronization barrier, Non-shareable, stores only (`dsb nshst`).
pub unsafe fn dsb_nshst() { _dsb_nshst() }
extern "intrinsic" fn _dsb_nshst()

/// Data memory barrier, Inner Shareable (`dmb ish`).
pub unsafe fn dmb_ish() { _dmb_ish() }
extern "intrinsic" fn _dmb_ish()

/// Data memory barrier, Inner Shareable, loads (`dmb ishld`).
pub unsafe fn dmb_ishld() { _dmb_ishld() }
extern "intrinsic" fn _dmb_ishld()

/// Data memory barrier, Inner Shareable, stores (`dmb ishst`).
pub unsafe fn dmb_ishst() { _dmb_ishst() }
extern "intrinsic" fn _dmb_ishst()

/// Invalidate all instruction caches to the Point of Unification, this core (`ic iallu`). EL1.
pub unsafe fn ic_iallu() { _ic_iallu() }
extern "intrinsic" fn _ic_iallu()

/// As `ic_iallu` for the Inner Shareable domain (`ic ialluis`).
pub unsafe fn ic_ialluis() { _ic_ialluis() }
extern "intrinsic" fn _ic_ialluis()

/// Invalidate the instruction cache line containing `va` to the PoU (`ic ivau, Xt`). Needs EL0 access (SCTLR_EL1.UCI) or EL1.
pub unsafe fn ic_ivau(va u64) { _ic_ivau(va) }
extern "intrinsic" fn _ic_ivau(va u64)

/// Clean and invalidate the data cache line containing `va` to the Point of Coherency (`dc civac, Xt`).
pub unsafe fn dc_civac(va u64) { _dc_civac(va) }
extern "intrinsic" fn _dc_civac(va u64)

/// Clean the data cache line containing `va` to the PoC (`dc cvac, Xt`).
pub unsafe fn dc_cvac(va u64) { _dc_cvac(va) }
extern "intrinsic" fn _dc_cvac(va u64)

/// Invalidate (without cleaning) the data cache line containing `va` to the PoC (`dc ivac, Xt`). EL1. Discards dirty data
/// of the line and of unrelated data sharing it: only for lines the caller owns entirely.
pub unsafe fn dc_ivac(va u64) { _dc_ivac(va) }
extern "intrinsic" fn _dc_ivac(va u64)

/// Zero the block containing `va` (`dc zva, Xt`); its size is `4 << (dczid_el0() & 15)` bytes and `va` selects the aligned block.
/// Faults if `dczid_el0()` bit 4 is set. Needs normal memory.
pub unsafe fn dc_zva(va u64) { _dc_zva(va) }
extern "intrinsic" fn _dc_zva(va u64)

/// Clean the data cache line containing `va` to the Point of Unification (`dc cvau, Xt`).
pub unsafe fn dc_cvau(va u64) { _dc_cvau(va) }
extern "intrinsic" fn _dc_cvau(va u64)

/// Translate `va` for an EL1 read with stage 1 (`at s1e1r, Xt`); the result is in `read_par_el1()`. EL1. Follow with `isb()` before reading PAR_EL1.
pub unsafe fn at_s1e1r(va u64) { _at_s1e1r(va) }
extern "intrinsic" fn _at_s1e1r(va u64)

/// Translate `va` for an EL1 write with stage 1 (`at s1e1w, Xt`); the result is in `read_par_el1()`. EL1. Follow with `isb()`.
pub unsafe fn at_s1e1w(va u64) { _at_s1e1w(va) }
extern "intrinsic" fn _at_s1e1w(va u64)

