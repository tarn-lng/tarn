pub unsafe fn read_mair_el1() u64 { return _read_mair_el1() }
extern "intrinsic" fn _read_mair_el1() u64

/// Write `MAIR_EL1`: Memory attribute indirection. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn write_mair_el1(value u64) { _write_mair_el1(value) }
extern "intrinsic" fn _write_mair_el1(value u64)

/// Read `SCTLR_EL1`: System control (MMU, caches). Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_sctlr_el1() u64 { return _read_sctlr_el1() }
extern "intrinsic" fn _read_sctlr_el1() u64

