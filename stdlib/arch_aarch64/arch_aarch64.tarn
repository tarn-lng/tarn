pub unsafe fn write_spsr_el1(value u64) { _write_spsr_el1(value) }
extern "intrinsic" fn _write_spsr_el1(value u64)

/// Read `CNTV_CTL_EL0`: Virtual timer control. Needs EL1 unless the register is EL0-accessible.
pub unsafe fn read_cntv_ctl_el0() u64 { return _read_cntv_ctl_el0() }
extern "intrinsic" fn _read_cntv_ctl_el0() u64

